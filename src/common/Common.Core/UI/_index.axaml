<ResourceDictionary xmlns="https://github.com/avaloniaui"
										xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
										xmlns:converters="clr-namespace:ZitApp.UI.Converters">
	<converters:LogLevelToConverter
		x:Key="LogLevelToConverter"
		Info="{StaticResource Brush-Grey0}"
		Error="{StaticResource Brush-Red7}"
		Warning="{StaticResource Brush-Orange5}"
		Debug="{StaticResource Brush-Grey4}"
		Trace="{StaticResource Brush-Grey5}" />
	<ResourceDictionary.MergedDictionaries>
		<ResourceInclude Source="Controls/ViewContainer.axaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>