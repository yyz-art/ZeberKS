<UiView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ZitApp.Models;assembly=ZitApp.Core"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="ZitApp.UI.MainView"
             x:DataType="MainVM"
             UiTickInterval="300"
             UiTickCommand="{Binding UiTickCommand}"
             Background="#262626">
    <UiView.Styles>
       <Style Selector="Label.Value">
          <Setter Property="CornerRadius" Value="3" />
          <Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
       </Style>
       <Style Selector="TextBlock.Label">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="VerticalAlignment" Value="Center"></Setter>
       </Style>
    </UiView.Styles>
    <Design.DataContext>
       <MainVM />
    </Design.DataContext>
    <LayoutDockPanel LeftContentWidth="300" BottomLeftContentWidth="1*" BottomRightContentWidth="300"
                            LeftTopContentHeight="Auto" LeftBottomContentHeight="*" RightContentWidth="300"
                            RightTopContentHeight="Auto" RightBottomContentHeight="Auto" BottomContentHeight="200">
       <LayoutDockPanel.CenterContent>
          <Grid ColumnDefinitions="0,*" RowDefinitions="*,4,320" ColumnSpacing="4">
             <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,*" ColumnSpacing="10" RowSpacing="10" Margin="10">
                   <LinearPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <CheckBox Content="MES跳过"
                                IsChecked="{Binding CoreService.MesSkipEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Foreground="White" />

                   </LinearPanel>
                   <Button Grid.Row="1" Grid.Column="0"
                           Content="左工位图像路径"
                           Command="{Binding SelectLeftWorkImagePathCommand}"
                           HorizontalAlignment="Left"
                           Padding="12 3"
                           Margin="0,0,0,4" />
                   <Button Grid.Row="1" Grid.Column="1"
                           Content="右工位图像路径"
                           Command="{Binding SelectRightWorkImagePathCommand}"
                           HorizontalAlignment="Left"
                           Padding="12 3"
                           Margin="0,0,0,4" />
                   <Border Grid.Row="2" Grid.Column="0" Background="Bisque">
                      <Image Source="{Binding LeftWorkImage}" Stretch="Uniform" />
                   </Border>
                   <Border Grid.Row="2" Grid.Column="1" Background="Bisque">
                      <Image Source="{Binding RightWorkImage}" Stretch="Uniform" />
                   </Border>
                </Grid>
             </Border>
             <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />

             <ViewContainer Grid.Row="2" Grid.Column="1" Header="{StaticResource I18N.Common.双轴轨道位置}">
                <PercentCanvas>
                   <Rectangle Fill="Aqua" Height="40" PercentCanvas.Anchor="Center" PercentCanvas.HStretch="1"
                                  PercentCanvas.XPercent="0.5" PercentCanvas.YPercent="0.25" />

                   <Rectangle Fill="Aqua" Height="40" PercentCanvas.Anchor="Center" PercentCanvas.HStretch="1"
                                  PercentCanvas.XPercent="0.5" PercentCanvas.YPercent="0.75" />

                   <Ellipse Fill="Coral" Width="30" Height="30" PercentCanvas.Anchor="Center"
                               PercentCanvas.XPercent="{Binding Axis1Percent, Mode=TwoWay}" PercentCanvas.YPercent="0.25" />

                   <Ellipse Fill="Coral" Width="30" Height="30" PercentCanvas.Anchor="Center"
                               PercentCanvas.XPercent="{Binding Axis2Percent, Mode=TwoWay}" PercentCanvas.YPercent="0.75" />
                </PercentCanvas>
             </ViewContainer>
          </Grid>
       </LayoutDockPanel.CenterContent>
       <LayoutDockPanel.RightTopContent>
          <ViewContainer Grid.Row="2" Grid.Column="0" Header="{StaticResource I18N.Common.设备详情}">
             <StackPanel Orientation="Vertical" Spacing="5">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="5" Margin="0,0,0,10">
                   <Label FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="扫码结果" Background="#277679" Foreground="White"
                          HorizontalAlignment="Stretch" />

                   <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="左工位:" />
                   <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkLeftService.扫码}" IsReadOnly="True" />

                   <Label Classes="Label" Grid.Row="2" Grid.Column="0" Content="右工位:" />
                   <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WorkRightService.扫码}" IsReadOnly="True" />
                </Grid>

                <StackPanel Orientation="Vertical">
                   <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                      <Label FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Content="PLC 网络连接" Background="#277679" Foreground="White"
                             HorizontalAlignment="Stretch" />

                      <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="IP:" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayPlcIp}" IsReadOnly="True" />
                   </Grid>
                   <Button Content="打开 PLC IO 监控"
                           Command="{Binding OpenIoMonitor}"
                           Background="#277679" Foreground="White"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Margin="0,10,0,0" Padding="5"/>
                </StackPanel>
             </StackPanel>
          </ViewContainer>

       </LayoutDockPanel.RightTopContent>
       <LayoutDockPanel.RightBottomContent>
          <ViewContainer Header="工位2螺丝数据" Padding="4" Background="#423e3e">
             <DataGrid ItemsSource="{Binding WorkRightService.ScrewTightenResults}"
                       GridLinesVisibility="All"
                       BorderBrush="{DynamicResource Brush-Border}"
                       BorderThickness="1"
                       AutoGenerateColumns="False"
                       CanUserResizeColumns="True"
                       IsReadOnly="True">
                <DataGrid.Columns>
                   <DataGridTextColumn Header="螺丝" Binding="{Binding ScrewNo}" Width="55" />
                   <DataGridTextColumn Header="扭力(kgf·cm)" Binding="{Binding MaxTorque,StringFormat='{}{0:F2}'}" Width="*" />
                   <DataGridTextColumn Header="圈数" Binding="{Binding Turns,StringFormat='{}{0:F2}'}" Width="*" />
                   <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70" />
                </DataGrid.Columns>
             </DataGrid>
          </ViewContainer>
       </LayoutDockPanel.RightBottomContent>
       <LayoutDockPanel.LeftTopContent>
          <ViewContainer Header="{StaticResource I18N.Common.生产信息}" Padding="5">
             <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5"
                      RowSpacing="5">
                <Grid.Styles>
                   <Style Selector="Label.Value">
                      <Setter Property="CornerRadius" Value="3" />
                      <Setter Property="MinHeight" Value="30" />
                      <Setter Property="Padding" Value=" 3 0 0 0" />
                      <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                      <Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
                   </Style>
                   <Style Selector="Label.Label">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="VerticalAlignment" Value="Center"></Setter>
                   </Style>
                </Grid.Styles>
                <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="{StaticResource I18N.Common.工单号_}" />
                <Label Classes="Value" Grid.Row="1" Grid.Column="1" Content="{Binding CoreService.工单号}" />
                <Label Classes="Label" Grid.Row="2" Grid.Column="0" Content="{StaticResource I18N.Common.已生产数量_}" />
                <Label Classes="Value" Grid.Row="2" Grid.Column="1" Content="{Binding PlcRead.已生产数量}" />
                <Label Classes="Label" Grid.Row="3" Grid.Column="0" Content="工站名:" />
                <LinearPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                   <TextBox Text="{Binding StationNameInput, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch" />
                   <Button Content="确认" Command="{Binding ConfirmStationNameChangeCommand}" MinHeight="30" Padding="10 0" />
                </LinearPanel>
                <Label Classes="Label" Grid.Row="4" Grid.Column="0" Content="{StaticResource I18N.Common.CT_}" />
                <Label Classes="Value" Grid.Row="4" Grid.Column="1" Content="{Binding CTSecondsDisplay}" />
                <Label Classes="Label" Grid.Row="5" Grid.Column="0" Content="{StaticResource I18N.Common.工号_}" />
                <LinearPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                   <TextBox Text="{Binding WorkNoInput, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch" />
                   <Button Content="确认" Command="{Binding ConfirmWorkNoChangeCommand}" MinHeight="30" Padding="10 0" />
                </LinearPanel>
                <Label Classes="Label" Grid.Row="6" Grid.Column="0" Content="{StaticResource I18N.Common.当前配方_}" />
                <Label Classes="Value" Grid.Row="6" Grid.Column="1" Content="{Binding CoreService.当前下发配方.Name}" />
             </Grid>
          </ViewContainer>

       </LayoutDockPanel.LeftTopContent>
       <LayoutDockPanel.LeftBottomContent>
          <ViewContainer Header="工位1螺丝数据" Padding="4" Background="#423e3e">
             <DataGrid ItemsSource="{Binding WorkLeftService.ScrewTightenResults}"
                       GridLinesVisibility="All"
                       BorderBrush="{DynamicResource Brush-Border}"
                       BorderThickness="1"
                       AutoGenerateColumns="False"
                       CanUserResizeColumns="True"
                       IsReadOnly="True">
                <DataGrid.Columns>
                   <DataGridTextColumn Header="螺丝" Binding="{Binding ScrewNo}" Width="55" />
                   <DataGridTextColumn Header="扭力(kgf·cm)" Binding="{Binding MaxTorque,StringFormat='{}{0:F2}'}" Width="*" />
                   <DataGridTextColumn Header="圈数" Binding="{Binding Turns,StringFormat='{}{0:F2}'}" Width="*" />
                   <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="70" />
                </DataGrid.Columns>
             </DataGrid>
          </ViewContainer>
       </LayoutDockPanel.LeftBottomContent>

       <LayoutDockPanel.BottomLeftContent>
          <TabControl TabStripPlacement="Bottom">
             <TabItem Header="{StaticResource I18N.Common.日志栏}">
                <DataGrid Name="LogsDataGrid" ItemsSource="{Binding Logs}" GridLinesVisibility="All"
                               BorderBrush="{DynamicResource Brush-Border}" BorderThickness="1"
                               CanUserResizeColumns="True" FrozenColumnCount="3">
                   <DataGrid.Columns>
                      <DataGridTextColumn Header="记录器" Binding="{Binding LoggerName}" MinWidth="50" />
                      <DataGridTextColumn Header="时间" Binding="{Binding TimeStamp}" MinWidth="50" />
                      <DataGridTemplateColumn Header="等级">
                         <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                               <SelectableTextBlock
                                  Text="{Binding Level}" VerticalAlignment="Center" Padding="3 0"
                                  Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
                            </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="信息" Width="800">
                         <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                               <SelectableTextBlock
                                  Text="{Binding FormattedMessage}" VerticalAlignment="Center" Padding="3 0"
                                  Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
                            </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="异常" Binding="{Binding Exception}" Foreground="OrangeRed" MinWidth="50" />
                   </DataGrid.Columns>
                </DataGrid>
             </TabItem>
             </TabControl>
       </LayoutDockPanel.BottomLeftContent>

       <LayoutDockPanel.BottomRightContent>
          <LinearPanel Orientation="Vertical" Spacing="10">
             <ViewContainer Header="{StaticResource I18N.Common.设备状态}">
                <StackPanel Orientation="Vertical" Background="#252526" Margin="10">
             
                   <LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding PlcService.IsConnected}" />
                      </Grid>
                
                      <TextBlock Text="PLC" VerticalAlignment="Center" Foreground="White" />
                
                      <TextBlock Text="{Binding PlcService.Status}" VerticalAlignment="Center" Foreground="#AAAAAA" />
                   </LinearPanel>

                   <LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScanner1Connected}" />
                      </Grid>
                      <TextBlock Text="Scanner1" Foreground="White" VerticalAlignment="Center"/>
                   </LinearPanel>
             
                   <LinearPanel Orientation="Horizontal" Spacing="8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScanner2Connected}" />
                      </Grid>
                      <TextBlock Text="Scanner2" Foreground="White" VerticalAlignment="Center"/>
                   </LinearPanel>

                   <LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScrew1Connected}" />
                      </Grid>
                      <TextBlock Text="SCREW1" Foreground="White" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Screw1Status}" VerticalAlignment="Center" Foreground="#AAAAAA" />
                   </LinearPanel>

                   <LinearPanel Orientation="Horizontal" Spacing="8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScrew2Connected}" />
                      </Grid>
                      <TextBlock Text="SCREW2" Foreground="White" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Screw2Status}" VerticalAlignment="Center" Foreground="#AAAAAA" />
                   </LinearPanel>
             
                </StackPanel>
             </ViewContainer>

             <LinearPanel Orientation="Horizontal" Spacing="10" Margin="2 4">
                <Label Content="联系方式:" FontWeight="Bold" />
                <TextBlock Text="{Binding AppConfig.联系方式}"></TextBlock>
             </LinearPanel>
          </LinearPanel>
       </LayoutDockPanel.BottomRightContent>
    </LayoutDockPanel>
</UiView>
