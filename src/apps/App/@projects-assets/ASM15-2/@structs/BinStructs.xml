<?xml version="1.0" encoding="UTF-8" ?>
<BinStructProject>
	<!-- PlcStruct -->
	<Struct
		Usings="ZC.BinStructs;ZitApp.Devices.Plc;ZC.BinStructs1;"
		Namespace="ZitApp.BinStructs"
		Name="PlcStruct"
		Length="20" LengthUnit="2" ByteFormat="ByteFormat.CDAB"
		OutputFile="gen/PlcStruct.gen.cs">
		<BinaryPointGroup Name="PlcToPc" Start="22000" End="22999"/>
		<BinaryPointGroup Name="PcToPlc" Start="21000" End="21999"/>
		<CsvIncludePoints
			Name="交互信号PLC->PC" FilePath="PlcRead.csv">
			<Setter Property="UseValueInfo" Value="False"/>
			<Setter Property="DataType" Value="float"/>
			<Setter Property="BeforeToken" Value="public partial"/>
			<Setter Property="Tags">PLC->PC</Setter>
			<Setter Property="Category">PLC/PLC->PC</Setter>
			<Setter Property="ReaderData">PLC</Setter>
			<Setter Property="WriterData">PLC</Setter>
			<!--			<Setter Property="AttachDataNames">NameByCN,NameByEN,NameByVI</Setter>-->
		</CsvIncludePoints>
		<CsvIncludePoints
			Name="交互信号PC->PLC" FilePath="PlcWrite.csv">
			<Setter Property="UseValueInfo" Value="False"/>
			<Setter Property="DataType" Value="float"/>
			<Setter Property="BeforeToken" Value="public partial"/>
			<Setter Property="Tags">PC->PLC</Setter>
			<Setter Property="Category">PLC/PC->PLC</Setter>
			<Setter Property="ReaderData">PLC</Setter>
			<Setter Property="WriterData">PLC</Setter>
			<!--			<Setter Property="AttachDataNames">NameByCN,NameByEN,NameByVI</Setter>-->
		</CsvIncludePoints>
	</Struct>

	<!-- PlcAlarmStruct -->
	<Struct
		Usings="ZC.BinStructs;ZitApp.Devices.Plc;"
		Namespace="ZitApp.BinStructs"
		Name="PlcAlarmStruct"
		Length="20" LengthUnit="2" ByteFormat="ByteFormat.CDAB"
		OutputFile="gen/PlcAlarmStruct.gen.cs">
		<BinaryPointGroup Name="Part1" Start="22500" End="22700" Tags="WordBool"/>
		<CsvIncludePoints Name="报警" FilePath="PlcAlarm.csv">
			<Setter Property="DataType" Value="WordBool"/>
			<Setter Property="InitExpress" Value="new WordBool();"/>
			<Setter Property="BeforeToken" Value="public partial"/>
			<Setter Property="Tags">WordBool</Setter>
			<Setter Property="Category">Alarm</Setter>
			<Setter Property="ReaderData">PLC</Setter>
			<Setter Property="WriterData">PLC</Setter>
			<Setter Property="AttachDataNames">Id,NameByCN,NameByEN,NameByVI,TipMessage</Setter>
		</CsvIncludePoints>
	</Struct>
	<!-- ProductRecipe -->
	<Struct
		Usings="ZC.BinStructs;"
		Namespace="ZitApp.BinStructs"
		Name="PointRecipeStruct"
		Length="20" LengthUnit="2" ByteFormat="ByteFormat.CDAB"
		OutputFile="gen/PointRecipeStruct.gen.cs">
		<!-- PLC -->
		<CsvIncludePoints Name="PLC" FilePath="PlcRecipe.csv">
			<Setter Property="DataType" Value="float"/>
			<Setter Property="BeforeToken" Value="public"/>
			<Setter Property="Tags">轴位置</Setter>
			<Setter Property="ReaderData">PLC</Setter>
			<Setter Property="WriterData">PLC</Setter>
			<Setter Property="AttachDataNames">NameByCN,NameByEN,NameByVI</Setter>
		</CsvIncludePoints>
	</Struct>
</BinStructProject>
