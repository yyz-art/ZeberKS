<UiView xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:models="clr-namespace:ZitApp.Models;assembly=ZitApp.Core"
				xmlns:libs="https://zc.com/ui"
				xmlns:contexts="clr-namespace:ZitApp.Contexts"
				xmlns:contexts1="clr-namespace:ZitApp.Contexts;assembly=ZitApp.Core"
				mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="980"
				x:Class="ZitApp.UI.MainView"
				x:DataType="MainVM"

				Name="RootView"
				UiTickInterval="300"
				UiTickCommand="{Binding UiTickCommand}"
				ShowContentMode="ForegroundContent"
				Background="#262626">
	<UiView.Styles>
		<Style Selector="Label.Value">
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Padding" Value="2" />
			<Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
		</Style>
		<Style Selector="TextBlock.Label">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center"></Setter>
		</Style>
	</UiView.Styles>
	<Design.DataContext>
		<MainVM />
	</Design.DataContext>
	<UiView.DialogsContent>
		<TabControl>
			<TabItem Header="ReplaceMaterialDialog">
				<RelativePanel>
					<DefaultDialog Name="ReplaceMaterialDialog" Height="340" Width="600" Title="{StaticResource I18N.G.替换物料}">
						<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10"
									RowSpacing="10">
							<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{StaticResource I18N.G.名称}" />
							<Label Grid.Row="0" Grid.Column="1" MinHeight="28" VerticalContentAlignment="Center"
										Content="{Binding EditMaterialSpaceContext.Config.PositionName}" />

							<TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{StaticResource I18N.G.位置码}" />
							<TextBox Grid.Row="1" Grid.Column="1" BorderBrush="{Binding InputMaterialPositionCodeBorderBrush}"
											Text="{Binding InputMaterialPositionCode}" />

							<TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{StaticResource I18N.G.物料码}" />
							<TextBox Grid.Row="2" Grid.Column="1" BorderBrush="{Binding InputMaterialCodeBorderBrush}"
											Text="{Binding InputMaterialCode}" />

							<TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{StaticResource I18N.G.数量}" />
							<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InputMaterialCount}" />

							<TextBlock Grid.Row="4" Grid.Column="1" MinHeight="30" HorizontalAlignment="Center"
												Text="{Binding ReplaceMaterialTipMessage}" />

							<StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
													HorizontalAlignment="Center" Spacing="10">

								<Button Content="{StaticResource I18N.G.取消}" Command="{Binding #ReplaceMaterialDialog.CloseCommand}" />
								<Button Content="{StaticResource I18N.G.清空}" Classes="Secondary" Theme="{DynamicResource Button-Outline}"
												Command="{Binding #ReplaceMaterialDialog.CloseCommand}" />
								<Button Content="{StaticResource I18N.G.确定}" Theme="{StaticResource Button-Solid}"
												Command="{Binding MaterialReplaceConfirmCommand}" />
							</StackPanel>
						</Grid>
					</DefaultDialog>
				</RelativePanel>
			</TabItem>
		</TabControl>
	</UiView.DialogsContent>
	<LayoutDockPanel LeftContentWidth="300" BottomLeftContentWidth="1*" BottomRightContentWidth="240"
									LeftTopContentHeight="Auto" LeftBottomContentHeight="*" RightContentWidth="Auto"
									RightTopContentHeight="Auto" RightBottomContentHeight="Auto" BottomContentHeight="200">
		<LayoutDockPanel.CenterContent>
			<Grid ColumnDefinitions="0,*" RowDefinitions="*,4,Auto" ColumnSpacing="4">
				<Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="10 5">
					<ItemsControl ItemsSource="{Binding WorkPositionContexts}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="2" ColumnSpacing="10" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#1f1f1f" BorderBrush="#3f3f3f" BorderThickness="1" Padding="5">
									<Grid RowDefinitions="Auto,Auto,*,40,Auto" RowSpacing="8">
										<LinearPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
											<TextBlock Text="SN" Foreground="#c8c8c8" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
											<Label Content="{Binding ScanSnCode}" Classes="Value" FontSize="16" Padding="5" MinWidth="240" />
											<Control LinearPanel.Weight="1" />
											<TextBlock Text="{Binding WorkStep}" FontSize="16" FontWeight="Bold" Foreground="#ffffff"
																VerticalAlignment="Center" />
											<Label Content="{Binding ProductionState}"
														Background="{Binding ProductionState, Converter= {StaticResource StateColorCvt}}"
														VerticalAlignment="Center" Padding="20 2" FontSize="20" />
										</LinearPanel>
										<LinearPanel Grid.Row="1" Orientation="Horizontal">
											<TextBlock Text="{Binding LastError}" Foreground="OrangeRed" />
											<Control LinearPanel.Weight="1" />

										</LinearPanel>
										<Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
											<LinearPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
												<ComboBox ItemsSource="{Binding ImageInfos}" SelectedValue="{Binding SelectedImageInfo}"
																	HorizontalAlignment="Stretch" LinearPanel.Weight="1">
													<ComboBox.ItemTemplate>
														<DataTemplate>
															<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
												<Button Content="{StaticResource I18N.G.打开图片文件夹}" Classes="Secondary" />
											</LinearPanel>
											<libs:ImageViewer Grid.Row="1" Source="{Binding Image}" />
										</Grid>

										<PercentCanvas Grid.Row="3" Margin="0 0">
											<Rectangle Fill="DodgerBlue" RadiusX="5" RadiusY="5" Height="15" PercentCanvas.Anchor="Center"
																PercentCanvas.HStretch="1"
																PercentCanvas.XPercent="0.5" PercentCanvas.YPercent="0.5" />
											<Rectangle Fill="LightSeaGreen" Width="20" Height="30" PercentCanvas.Anchor="Center"
																PercentCanvas.XPercent="{Binding AxisPercent, Mode=TwoWay}" PercentCanvas.YPercent="0.5" />
										</PercentCanvas>
										<Grid Grid.Row="4" IsVisible="{Binding IsUsedScrewInstallDataGrid}" Height="148">
											<DataGrid ItemsSource="{Binding ScrewInstallDataList}" VerticalScrollBarVisibility="Visible"
																GridLinesVisibility="All"
																BorderBrush="{DynamicResource Brush-Border}" BorderThickness="1">
												<DataGrid.Columns>
													<DataGridTextColumn Header="ID" Binding="{Binding Id}" />
													<DataGridTextColumn Header="SN" Binding="{Binding Sn1}" />
													<DataGridTextColumn Header="No" Binding="{Binding ScrewNo}" />
													<DataGridTextColumn Header="{StaticResource I18N.G.扭矩}" Binding="{Binding MaxTorque}" />
													<DataGridTextColumn Header="{StaticResource I18N.G.圈数}" Binding="{Binding Turns}" />
													<DataGridTextColumn Header="{StaticResource I18N.G.时间}" Binding="{Binding CollectedAt}" />
												</DataGrid.Columns>
											</DataGrid>
										</Grid>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
				<GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
				<!-- 吸头 -->
				<ViewContainer Grid.Row="2" Grid.Column="1" Header="{StaticResource I18N.G.吸嘴压力点检}"
											IsVisible="{Binding HasNozzleContexts}" MinHeight="110">
					<ItemsControl ItemsSource="{Binding NozzleContexts}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="{Binding NozzleContexts.Count}" ColumnSpacing="5" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#1f1f1f" LinearPanel.Weight="1">
									<Grid RowDefinitions="Auto,*">
										<Label Grid.Row="0" Grid.Column="0" Content="{Binding Config.Name}" HorizontalContentAlignment="Center"
													BorderBrush="White"
													BorderThickness="0 0 0 1" FontSize="18"
													Background="{Binding ProductionState, Converter={StaticResource StateColorCvt}}" />
										<Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5"
													RowSpacing="5"
													Margin="5">
											<TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.G.范围}" />
											<Label Grid.Row="0" Grid.Column="1" Classes="Value" Grid.ColumnSpan="2">
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Config.PressureMinValue}" />
													<TextBlock Text="~" />
													<TextBlock Text="{Binding Config.PressureMaxValue}" />
												</StackPanel>
											</Label>
											<TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.G.压力}" />
											<Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Value}"
														VerticalContentAlignment="Center" />
											<Button Grid.Row="1" Grid.Column="2" Content="{StaticResource I18N.G.点检}"
															Margin="0" Padding="2"
															Command="{Binding #RootView.DataContext.NozzleInspectionCommand}"
															CommandParameter="{Binding .}" />
										</Grid>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ViewContainer>
			</Grid>
		</LayoutDockPanel.CenterContent>
		<LayoutDockPanel.RightTopContent>
			<ViewContainer Header="物料" Padding="0">
				<ItemsControl ItemsSource="{Binding MaterialSpaceContexts}">
					<ItemsControl.Styles>
						<Style Selector="ViewContainer">
							<Setter Property="Padding" Value="4" />
							<Setter Property="VerticalAlignment" Value="Stretch" />
							<Setter Property="Background" Value="#423e3e" />
						</Style>
						<Style Selector="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>
						<Style Selector="Label">
							<Setter Property="HorizontalAlignment" Value="Stretch" />
							<Setter Property="VerticalAlignment" Value="Stretch" />
							<Setter Property="MinHeight" Value="26" />
							<Setter Property="Padding" Value="5 2" />
						</Style>
					</ItemsControl.Styles>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ViewContainer IsVisible="{Binding Config.IsUsed}" MinWidth="240">
								<ViewContainer.Header>
									<LinearPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" Padding="2 2 6 2"
															Background="{Binding MaterialState, Converter={x:Static contexts1:MaterialSpaceContext.DefaultStateColorConverter}}">
										<TextBlock Text="{Binding Config.PositionName}" />
										<Control LinearPanel.Weight="1" />
										<Panel>
											<Button Content="{StaticResource I18N.G.解锁}" IsVisible="{Binding !IsUnlocked}" Classes="Primary"
															Theme="{DynamicResource Button-Solid}"
															Padding="10 2" Command="{Binding ToggleLockCommand}" CommandParameter="{Binding .}" />
											<Button Content="{StaticResource I18N.G.锁定}" IsVisible="{Binding IsUnlocked}" Classes="Danger"
															Theme="{DynamicResource Button-Solid}"
															Padding="10 2" Command="{Binding ToggleLockCommand}" CommandParameter="{Binding .}" />
										</Panel>

										<Button Content="{StaticResource I18N.G.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
														Padding="10 2 "
														Command="{Binding MaterialReplaceCommand}" CommandParameter="{Binding .}" />
									</LinearPanel>
								</ViewContainer.Header>
								<Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="5"
											Margin="3">
									<TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.G.位置码_}" />
									<Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Classes="Value"
												Content="{Binding PositionCode}" />
									<TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.G.物料码_}" />
									<Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="Value" Content="{Binding MaterialCode}" />
									<TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.G.抛料率_}" />
									<Label Grid.Row="2" Grid.Column="1" Classes="Value" Content="{Binding ScrapRate,StringFormat='{}{0:F2}%'}" />
									<TextBlock Grid.Row="2" Grid.Column="2" Classes="Label" Text="{StaticResource I18N.G.剩余量_}" />
									<!-- <ProgressBar Grid.Row="2" Grid.Column="3" Maximum="100" Minimum="0" ShowProgressText="True" Value="20"></ProgressBar> -->
									<Label Grid.Row="2" Grid.Column="3" Classes="Value" Content="{Binding RemainCount}" />
								</Grid>
							</ViewContainer>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</ViewContainer>

		</LayoutDockPanel.RightTopContent>
		<LayoutDockPanel.RightBottomContent>

		</LayoutDockPanel.RightBottomContent>
		<LayoutDockPanel.LeftTopContent>
			<StackPanel Orientation="Vertical">
				<ViewContainer Header="{StaticResource I18N.G.生产信息}" Padding="5">
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5"
								RowSpacing="5">
						<Grid.Styles>
							<Style Selector="Label.Value">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="MinHeight" Value="30" />
								<Setter Property="Padding" Value=" 3 0 0 0" />
								<Setter Property="VerticalContentAlignment" Value="Center"></Setter>
								<Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
							</Style>
							<Style Selector="Label.Label">
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="VerticalAlignment" Value="Center"></Setter>
							</Style>
						</Grid.Styles>
						<Label Classes="Label" Grid.Row="0" Grid.Column="0" Content="{StaticResource I18N.G.机种型号_}" />
						<Label Classes="Value" Grid.Row="0" Grid.Column="1" Content="{Binding WorkRecipeName}" />
						<Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="{StaticResource I18N.G.工单号_}" />
						<Label Classes="Value" Grid.Row="1" Grid.Column="1" Content="{Binding WorkOrderNo}" />
						<Label Classes="Label" Grid.Row="2" Grid.Column="0" Content="{StaticResource I18N.G.已生产数量_}" />
						<Label Classes="Value" Grid.Row="2" Grid.Column="1" Content="{Binding PlcRead.已生产数量}" />
						<Label Classes="Label" Grid.Row="3" Grid.Column="0" Content="{StaticResource I18N.G.工站名_}" />
						<LinearPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="5">
							<TextBox Text="{Binding StationNameInput, Mode=TwoWay}" MinHeight="30" LinearPanel.Weight="1"
											HorizontalAlignment="Stretch" />
							<Button Content="{StaticResource I18N.G.确认}" Command="{Binding ConfirmStationNameChangeCommand}"
											MinHeight="30" Padding="10 0" />
						</LinearPanel>
						<Label Classes="Label" Grid.Row="4" Grid.Column="0" Content="{StaticResource I18N.G.CT_}" />
						<Label Classes="Value" Grid.Row="4" Grid.Column="1" Content="{Binding CTSeconds, StringFormat='{}{0:F2} S'}" />
						<Label Classes="Label" Grid.Row="5" Grid.Column="0" Content="{StaticResource I18N.G.工号_}" />
						<LinearPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="5">
							<TextBox Text="{Binding WorkNoInput, Mode=TwoWay}" LinearPanel.Weight="1" MinHeight="30"
											HorizontalAlignment="Stretch" />
							<Button Content="{StaticResource I18N.G.确认}" Command="{Binding ConfirmWorkNoChangeCommand}" MinHeight="30"
											Padding="10 0" />
						</LinearPanel>
						<LinearPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15"
												HorizontalAlignment="Center">
							<CheckBox Content="{StaticResource I18N.G.MES跳过}"
												IsChecked="{Binding CoreService.MesSkipEnabled, Mode=TwoWay}"
												VerticalAlignment="Center"
												Foreground="White" />
							<CheckBox Content="{StaticResource I18N.G.物料检查}"
												IsChecked="{Binding CoreService.MaterialCheck, Mode=TwoWay}"
												VerticalAlignment="Center"
												Foreground="White" />

							<CheckBox Content="{StaticResource I18N.G.配方检查}"
												IsChecked="{Binding CoreService.RecipeCheck, Mode=TwoWay}"
												VerticalAlignment="Center"
												Foreground="White" />
						</LinearPanel>
					</Grid>
				</ViewContainer>
				<StackPanel Orientation="Vertical" Spacing="5">
					<StackPanel Orientation="Vertical">
						<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
							<Label FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
										Content="{StaticResource I18N.G.PLC_网络连接}" Background="#277679" Foreground="White"
										HorizontalAlignment="Stretch" />

							<Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="IP:" VerticalAlignment="Center" />
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayPlcIp}" IsReadOnly="True" />
						</Grid>
						<Button Content="打开 PLC IO 监控"
										Command="{Binding OpenIoMonitor}"
										Background="#277679" Foreground="White"
										HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
										Margin="0,10,0,0" Padding="5" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</LayoutDockPanel.LeftTopContent>
		<LayoutDockPanel.LeftBottomContent>
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<LinearPanel Orientation="Vertical">
					<LinearPanel.Styles>
						<Style Selector="ViewContainer">
							<Setter Property="Padding" Value="4" />
							<Setter Property="VerticalAlignment" Value="Stretch" />
							<Setter Property="Background" Value="#423e3e" />
						</Style>
						<Style Selector="TextBlock">
							<Setter Property="HorizontalAlignment" Value="Right" />
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>
						<Style Selector="Label">
							<Setter Property="HorizontalAlignment" Value="Stretch" />
							<Setter Property="VerticalAlignment" Value="Stretch" />
							<Setter Property="MinHeight" Value="26" />
							<Setter Property="Padding" Value="5 2" />
						</Style>

					</LinearPanel.Styles>
				</LinearPanel>
			</ScrollViewer>
		</LayoutDockPanel.LeftBottomContent>

		<LayoutDockPanel.BottomLeftContent>
			<ViewContainer Header="{StaticResource I18N.G.日志栏}" Padding="2">
				<DataGrid Name="LogsDataGrid" ItemsSource="{Binding Logs}" GridLinesVisibility="All"
									BorderBrush="{DynamicResource Brush-Border}" BorderThickness="1"
									CanUserResizeColumns="True" FrozenColumnCount="3">
					<DataGrid.Columns>
						<DataGridTextColumn Header="时间" Binding="{Binding TimeStamp}" MinWidth="50" />
						<DataGridTextColumn Header="记录器" Binding="{Binding LoggerName}" MinWidth="50" />
						<DataGridTemplateColumn Header="等级">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<SelectableTextBlock
										Text="{Binding Level}" VerticalAlignment="Center" Padding="3 0"
										Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="信息" Width="800">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<SelectableTextBlock
										Text="{Binding FormattedMessage}" VerticalAlignment="Center" Padding="3 0"
										Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="异常" Binding="{Binding Exception}" Foreground="OrangeRed" MinWidth="50" />
					</DataGrid.Columns>
				</DataGrid>
			</ViewContainer>

		</LayoutDockPanel.BottomLeftContent>

		<LayoutDockPanel.BottomRightContent>
			<LinearPanel Orientation="Vertical" Spacing="10">
				<ViewContainer Header="{StaticResource I18N.G.设备状态}" Padding="10">
					<ItemsControl ItemsSource="{Binding DeviceStatusContexts}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
									<MatchShow MatchValue="{Binding Status}">
										<Ellipse MatchShow.Option="Disconnected" Fill="Red" Width="10" Height="10" />
										<Ellipse MatchShow.Option="Connected" Fill="LimeGreen" Width="10" Height="10" />
									</MatchShow>
									<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" />
									<TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="#AAAAAA" />
								</LinearPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ViewContainer>
				<Control LinearPanel.Weight="1" />
				<LinearPanel Orientation="Horizontal" Spacing="10" Margin="2 4" Padding="5">
					<Label Content="联系方式:" FontWeight="Bold" />
					<TextBlock Text="{Binding AppConfig.联系方式}"></TextBlock>
				</LinearPanel>
			</LinearPanel>
		</LayoutDockPanel.BottomRightContent>
	</LayoutDockPanel>
</UiView>