<UiView xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="200"
				x:Class="ZitApp.UI.Main.DeviceStatusView">
	<UiView.Styles>
		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="#02ef02" />
		</Style>
	</UiView.Styles>
	<StackPanel Orientation="Vertical" Background="#252526">
		<TextBlock Text="Camera1"/>
		<TextBlock Text="Camera2" />
		<TextBlock Text="PLC" />
		<TextBlock Text="Scanner1" />
		<TextBlock Text="Scanner2" />
	</StackPanel>
</UiView>