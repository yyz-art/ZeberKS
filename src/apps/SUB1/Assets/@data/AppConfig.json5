{
  /* 数据库连接配置 123 */
  "Databases": [
    {
      "Name": null,
      "DbType": "Sqlite",
      "ConnectionString": "Data Source=data/app.db",
      /* 空闲时连接返回连接池(需要启用)*/
      "IsAutoCloseConnection": true
    }
  ],
  /* 任务服务配置 */
  "TaskServiceHostOptions": {
    /* 剩余启动次数 */
    "MaxRemainStartCount": -1,
    /* 启用任务服务自动重启 */
    "EnableAutoRestart": true,
    /* 启用线程运行模式 */
    "IsUseThreadLongRunningMode": false
  },
  "Plc": {
    "IpAddress": "192.168.1.50",
    "Port": 502
  },
  "Scanner1": {
    "Port": "COM5",
    "BaudRate": 1152200,
  },
  "Scanner2": {
    "Port": "COM6",
    "BaudRate": 1152200,
  }
}