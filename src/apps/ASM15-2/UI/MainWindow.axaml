<UiTopLevelWindow
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="using:ZitApp.UI"
	xmlns:global="clr-namespace:"
	x:Class="ZitApp.UI.MainWindow"
	Name="TopLevelWindow"
	Title="{x:Static global:App.ApplicationName}"
	WindowStartupLocation="CenterScreen"
	WindowState="Maximized"
	Icon="/UI/Assets/Images/logo.ico"
	UseLayoutRounding="True"
	RenderOptions.BitmapInterpolationMode="HighQuality"
	TransparencyLevelHint="AcrylicBlur"
	Width="1280" Height="720"
	SystemDecorations="BorderOnly"
	ExtendClientAreaChromeHints="NoChrome"
	ExtendClientAreaToDecorationsHint="True"
	ExtendClientAreaTitleBarHeightHint="30"
	UiTickCommand="{Binding UiTickCommand}"
	UiTickInterval="{Binding UiTickInterval}"
	ShowContentMode="ForegroundContent">
	<UiTopLevelWindow.DialogsContent>
		<TabControl>
			<TabItem Header="Login">
				<RelativePanel>
					<DefaultDialog Name="AccountLoginDialog" 
												Title="{StaticResource I18N.Common.账户登录}" MinWidth="400">
						<LinearPanel Orientation="Vertical" Spacing="10" Padding="20">
							<LinearPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
								<RadioButton GroupName="UserLogin" Content="管理员"
														Command="{Binding OnSelectedAccountChangedCommand}"
														CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"
														Foreground="White">
								</RadioButton>
								<RadioButton GroupName="UserLogin" Content="技术员"
														Command="{Binding OnSelectedAccountChangedCommand}"
														CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"
														Foreground="White">
								</RadioButton>
								<RadioButton GroupName="UserLogin" Content="操作员"
														Command="{Binding OnSelectedAccountChangedCommand}"
														CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"
														Foreground="White">
								</RadioButton>
							</LinearPanel>

							<LinearPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0 10">
								<TextBlock Text="工号:" VerticalAlignment="Center" />
								<TextBox Text="{Binding AccountLoginInputPassword}" MinWidth="160" PasswordChar="●" Padding="4"
												VerticalContentAlignment="Center">
								</TextBox>
							</LinearPanel>
							<LinearPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0 10">
								<TextBlock Text="密码:" VerticalAlignment="Center" />
								<TextBox Text="{Binding AccountLoginInputPassword}" MinWidth="160" PasswordChar="●" Padding="4"
												VerticalContentAlignment="Center">
								</TextBox>
							</LinearPanel>

							<Button Content="登陆" Command="{Binding AccountLoginConfirmCommand}" Padding="60 5" Theme="{DynamicResource Button-Solid}"></Button>
						</LinearPanel>
					</DefaultDialog>
				</RelativePanel>

			</TabItem>
		</TabControl>
	</UiTopLevelWindow.DialogsContent>
	<Design.DataContext>
		<ui:AppVM />
	</Design.DataContext>
	<Grid Name="MainContentGrid" RowDefinitions="Auto,*">
		<LinearPanel Name="WindowTitleBarPanel" Grid.Row="0" Background="#191a1c" Orientation="Horizontal">
			<Image Source="/UI/Assets/Images/logo-hori.jpg" Width="70" Margin="5 0 0 0" Height="30" />
			<Label Content="{x:Static global:App.ApplicationName}" Classes="" Theme="{DynamicResource Label-Tag}" Margin="4" VerticalAlignment="Stretch" />
			<Menu Name="AppBarMenu" x:DataType="AppVM">
				<Menu.Styles>
					<Style Selector="Menu > MenuItem">
						<Setter Property="Foreground" Value="#f5f5f5"></Setter>
						<Setter Property="Padding" Value="6 0"></Setter>
					</Style>
					<Style Selector="MenuItem.Nav-Active">
						<Setter Property="Background" Value="CornflowerBlue" />
					</Style>
					<Style Selector="MenuItem.NavInstance">
						<Setter Property="Command" Value="{Binding #AppBarMenu.DataContext.NavigateToCommand}" />
						<Setter Property="CommandParameter" Value="{Binding ., RelativeSource={RelativeSource Self}}" />
					</Style>
				</Menu.Styles>
				<MenuItem Header="{StaticResource I18N.Common.主页}" Tag="/主页" Classes="NavInstance" />
				<MenuItem Header="{StaticResource I18N.Common.配方}" Tag="/配方" Classes="NavInstance" />
				<MenuItem Header="{StaticResource I18N.Common.报警}" Tag="/报警" Classes="NavInstance" />
				<MenuItem Header="{StaticResource I18N.Common.设置}" Tag="/设置" Classes="NavInstance" />
				<MenuItem Header="{StaticResource I18N.Common.账户}">
					<MenuItem Header="{StaticResource I18N.Common.管理}" Tag="/账户管理" Classes="NavInstance" />
					<MenuItem Header="{StaticResource I18N.Common.登录}" Command="{Binding RequestLoginCommand}" />
					<MenuItem Header="注销" Command="{Binding RequestLoginCommand}" />

				</MenuItem>
				<MenuItem Header="{StaticResource I18N.Common.视图}">
					<MenuItem Header="{StaticResource I18N.Common.双轴轨道位置}" Tag="/测试" Classes="NavInstance" />
					<MenuItem Header="{StaticResource I18N.Common.全部}" ItemsSource="{Binding Ui.MainView.NavManager.Root.Children}">
						<MenuItem.ItemTemplate>
							<DataTemplate>
								<!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
								<MenuItem Header="{Binding Header}" Classes="NavInstance" />
							</DataTemplate>
						</MenuItem.ItemTemplate>
					</MenuItem>
				</MenuItem>
				<MenuItem Header="飞达物料" Tag="/飞达物料" Classes="NavInstance" />
			</Menu>
			<Label Content="V0.0.1" Margin="15 0 0 0" VerticalAlignment="Center" Foreground="{StaticResource Brush-Text3}"></Label>
			<Control LinearPanel.Weight="1" />
			<Button Content="{Binding AccountService.Account.DisplayName}"
							Theme="{DynamicResource Button-Outline}"
							Command="{Binding SwitchAccountCommand}" />
			<Label Content="{Binding SystemTime}" Margin="5 0" Classes="Ghost Blue" Theme="{DynamicResource Label-Tag}" />
			<Button Name="WindowFullScreenButton"
							Command="{Binding #TopLevelWindow.FullScreenCommand}"
							CommandParameter="{Binding RelativeSource={RelativeSource Self}  }"
							Theme="{StaticResource CaptionButton}">
				<PathIcon
					Name="WindowFullScreenButtonIcon"
					Theme="{StaticResource PathIcon-Inner}"
					Data="{StaticResource WindowExpandGlyph}"
					Foreground="{Binding $parent[Button].Foreground}" />
			</Button>
			<Button Name="WindowMinimizeButton"
							Command="{Binding #TopLevelWindow.MinimizeCommand}"
							CommandParameter="{Binding RelativeSource={RelativeSource Self}  }"
							Theme="{StaticResource CaptionButton}">
				<PathIcon
					Name="WindowMinimizeButtonIcon"
					Theme="{StaticResource PathIcon-Inner}"
					Data="{StaticResource WindowMinimizeGlyph}"
					Foreground="{Binding $parent[Button].Foreground}" />
			</Button>
			<Button Name="WindowMaximizeRestoreButton"
							Command="{Binding #TopLevelWindow.MaximizeRestoreCommand}"
							CommandParameter="{Binding RelativeSource={RelativeSource Self}  }"
							Theme="{StaticResource CaptionButton}">
				<PathIcon
					Name="WindowRestoreButtonIcon"
					Theme="{StaticResource PathIcon-Inner}"
					Data="{StaticResource WindowMaximizeGlyph}"
					Foreground="{Binding $parent[Button].Foreground}" />
			</Button>
			<Button Name="WindowCloseButton"
							Command="{Binding #TopLevelWindow.CloseCommand}"
							CommandParameter="{Binding RelativeSource={RelativeSource Self}  }"
							Theme="{StaticResource CaptionButton}">
				<PathIcon
					Name="WindowCloseButtonIcon"
					Theme="{StaticResource PathIcon-Inner}"
					Data="{StaticResource WindowCloseIconGlyph}"
					Foreground="{Binding $parent[Button].Foreground}" />
			</Button>
		</LinearPanel>
		<Border Name="WindowContentContainer" Child="{Binding Ui.MainView.NavManager.ActiveContent}" Grid.Row="1"
						Background="#262626">
		</Border>
	</Grid>
</UiTopLevelWindow>
