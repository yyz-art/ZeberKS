<UiView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ZitApp.Models;assembly=ZitApp.Core"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="ZitApp.UI.MainView"
             x:DataType="MainVM"
             UiTickInterval="300"
             UiTickCommand="{Binding UiTickCommand}"
             Background="#262626">
    <UiView.Styles>
       <Style Selector="Label.Value">
          <Setter Property="CornerRadius" Value="3" />
          <Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
       </Style>
       <Style Selector="TextBlock.Label">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="VerticalAlignment" Value="Center"></Setter>
       </Style>
    </UiView.Styles>
    <Design.DataContext>
       <MainVM />
    </Design.DataContext>
    <UiView.DialogsContent>
       <TabControl>
          <TabItem Header="NozzlePressure">
             <RelativePanel>
                <DefaultDialog RelativePanel.AlignHorizontalCenterWithPanel="True"
                               Name="NozzlePressureDialog"
                               Title="{Binding NozzlePressureDialogTitle}"
                               MinWidth="360" MinHeight="220">
                   <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                         RowSpacing="10" ColumnSpacing="10" Margin="20">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="地址:" VerticalAlignment="Center" />
                      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NozzlePressureAddressInput}" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="最大值:" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NozzlePressureMaxInput}" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="最小值:" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NozzlePressureMinInput}" />
                      <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="确定"
                              Command="{Binding ConfirmNozzlePressureCheckCommand}"
                              HorizontalAlignment="Center"
                              Padding="30 4" />
                   </Grid>
                </DefaultDialog>
             </RelativePanel>
          </TabItem>
       </TabControl>
    </UiView.DialogsContent>
    <LayoutDockPanel LeftContentWidth="300" BottomLeftContentWidth="1*" BottomRightContentWidth="300"
                            LeftTopContentHeight="Auto" LeftBottomContentHeight="*" RightContentWidth="300"
                            RightTopContentHeight="Auto" RightBottomContentHeight="Auto" BottomContentHeight="200">
       <LayoutDockPanel.CenterContent>
          <Grid ColumnDefinitions="0,*" RowDefinitions="*,4,320" ColumnSpacing="4">
             <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,*" ColumnSpacing="10" RowSpacing="10" Margin="10">
                   <LinearPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                      <CheckBox Content="MES跳过"
                                IsChecked="{Binding CoreService.MesSkipEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Foreground="White" />
                      <Control LinearPanel.Weight="1" />
                      <ComboBox ItemsSource="{Binding LeftImageNames}" SelectedIndex="0" VerticalAlignment="Center" />
                      <MatchShow MatchValue="{Binding LeftPassState}">
                         <Label MatchShow.Option="{x:Static models:PassState.OK}"
                                  Content="OK" Background="Green" VerticalAlignment="Center" Padding="20 2" FontSize="20" />
                      </MatchShow>

                   </LinearPanel>
                   <Border Grid.Row="2" Grid.Column="0" Background="#1f1f1f" BorderBrush="#3f3f3f" BorderThickness="1" Padding="12">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
                         <TextBlock Grid.Row="0" Text="左工位流程" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />
                         <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="SN:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkLeft.FlowSn}" Foreground="#ffffff" TextWrapping="Wrap" />
                         </Grid>
                         <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="机种:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkLeft.FlowModel}" Foreground="#ffffff" TextWrapping="Wrap" />
                         </Grid>
                         <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="当前步骤:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkLeft.FlowCurrentStep}" Foreground="#7bd88f" FontWeight="Bold" TextWrapping="Wrap" />
                         </Grid>
                         <StackPanel Grid.Row="4" Spacing="8">
                            <ItemsControl ItemsSource="{Binding WorkLeft.FlowStepItems}">
                               <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                     <WrapPanel />
                                  </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                     <Border Background="{Binding Background}" CornerRadius="4" Padding="8 4" Margin="0 0 6 6">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontWeight="Bold" />
                                     </Border>
                                  </DataTemplate>
                               </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                               <TextBlock Text="最后错误:" Foreground="#c8c8c8" />
                               <TextBlock Grid.Column="1" Text="{Binding WorkLeft.FlowLastError}" Foreground="#ff8a80" TextWrapping="Wrap" />
                            </Grid>
                         </StackPanel>
                      </Grid>
                   </Border>
                   <Border Grid.Row="2" Grid.Column="1" Background="#1f1f1f" BorderBrush="#3f3f3f" BorderThickness="1" Padding="12">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
                         <TextBlock Grid.Row="0" Text="右工位流程" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />
                         <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="SN:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkRight.FlowSn}" Foreground="#ffffff" TextWrapping="Wrap" />
                         </Grid>
                         <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="机种:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkRight.FlowModel}" Foreground="#ffffff" TextWrapping="Wrap" />
                         </Grid>
                         <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="当前步骤:" Foreground="#c8c8c8" />
                            <TextBlock Grid.Column="1" Text="{Binding WorkRight.FlowCurrentStep}" Foreground="#7bd88f" FontWeight="Bold" TextWrapping="Wrap" />
                         </Grid>
                         <StackPanel Grid.Row="4" Spacing="8">
                            <ItemsControl ItemsSource="{Binding WorkRight.FlowStepItems}">
                               <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                     <WrapPanel />
                                  </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                     <Border Background="{Binding Background}" CornerRadius="4" Padding="8 4" Margin="0 0 6 6">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontWeight="Bold" />
                                     </Border>
                                  </DataTemplate>
                               </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                               <TextBlock Text="最后错误:" Foreground="#c8c8c8" />
                               <TextBlock Grid.Column="1" Text="{Binding WorkRight.FlowLastError}" Foreground="#ff8a80" TextWrapping="Wrap" />
                            </Grid>
                         </StackPanel>
                      </Grid>
                   </Border>
                </Grid>
             </Border>
             <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />

             <ViewContainer Grid.Row="2" Grid.Column="1" Header="吸嘴压力点检">
                <Grid ColumnDefinitions="*" Margin="10">
                   <Border Grid.Column="0" Background="{Binding Nozzle1PressureBackground}" BorderBrush="#3f3f3f" BorderThickness="1" Padding="10">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                         <Label Grid.Row="0" Content="吸嘴1压力点检" Background="#277679" Foreground="White"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="Bold" />
                         <TextBox Grid.Row="1" Text="{Binding Nozzle1PressureCheckValue}" IsReadOnly="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                  FontSize="22" MinHeight="42" />
                         <Button Grid.Row="2" Content="设置" Command="{Binding SetNozzlePressureCheckCommand}"
                                 CommandParameter="1" HorizontalAlignment="Stretch" />
                      </Grid>
                   </Border>
                </Grid>
             </ViewContainer>
          </Grid>
       </LayoutDockPanel.CenterContent>
       <LayoutDockPanel.RightTopContent>
          <ViewContainer Grid.Row="2" Grid.Column="0" Header="扫码结果">
             <StackPanel Orientation="Vertical" Spacing="12">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                   <Label FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="扫码结果" Background="#277679" Foreground="White"
                          HorizontalAlignment="Stretch" />
                   <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="左工位:" />
                   <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkLeft.扫码}" IsReadOnly="True" />
                   <Label Classes="Label" Grid.Row="2" Grid.Column="0" Content="右工位:" />
                   <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WorkRight.扫码}" IsReadOnly="True" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                   <Label FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="PLC 网络连接" Background="#277679" Foreground="White"
                          HorizontalAlignment="Stretch" />
                   <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="IP:" />
                   <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayPlcIp}" IsReadOnly="True" />
                </Grid>
                <Button Content="打开 PLC IO 监控"
                        Command="{Binding OpenIoMonitor}"
                        Background="#277679" Foreground="White"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="5"/>
             </StackPanel>
          </ViewContainer>
       </LayoutDockPanel.RightTopContent>
       <LayoutDockPanel.RightBottomContent>
          <LinearPanel Orientation="Vertical">
             <LinearPanel.Styles>
                <Style Selector="ViewContainer">
                   <Setter Property="Padding" Value="4" />
                   <Setter Property="VerticalAlignment" Value="Stretch" />
                   <Setter Property="Background" Value="#423e3e" />
                </Style>
                <Style Selector="TextBlock">
                   <Setter Property="HorizontalAlignment" Value="Right" />
                   <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style Selector="Label">
                   <Setter Property="HorizontalAlignment" Value="Stretch" />
                   <Setter Property="VerticalAlignment" Value="Stretch"/>
                   <Setter Property="MinHeight" Value="26"/>
                   <Setter Property="Padding" Value="5 2"/>
                </Style>
             </LinearPanel.Styles>

             <ViewContainer Header="Feeder5">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder5MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder5Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder5抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder5IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder5" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder5IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder5" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>

             <ViewContainer Header="Feeder6">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder6MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder6Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder6抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder6IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder6" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder6IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder6" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>
          </LinearPanel>
       </LayoutDockPanel.RightBottomContent>
       <LayoutDockPanel.LeftTopContent>
          <ViewContainer Header="{StaticResource I18N.Common.生产信息}" Padding="5">
             <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5"
                      RowSpacing="5">
                <Grid.Styles>
                   <Style Selector="Label.Value">
                      <Setter Property="CornerRadius" Value="3" />
                      <Setter Property="MinHeight" Value="30" />
                      <Setter Property="Padding" Value=" 3 0 0 0" />
                      <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                      <Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
                   </Style>
                   <Style Selector="Label.Label">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="VerticalAlignment" Value="Center"></Setter>
                   </Style>
                </Grid.Styles>
                <Label Classes="Label" Grid.Row="0" Grid.Column="0" Content="机种号:" />
                <Label Classes="Value" Grid.Row="0" Grid.Column="1" Content="{Binding CoreService.当前下发配方.Name}" />
                <Label Classes="Label" Grid.Row="1" Grid.Column="0" Content="{StaticResource I18N.Common.工单号_}" />
                <Label Classes="Value" Grid.Row="1" Grid.Column="1" Content="{Binding CoreService.工单号}" />
                <Label Classes="Label" Grid.Row="2" Grid.Column="0" Content="{StaticResource I18N.Common.已生产数量_}" />
                <Label Classes="Value" Grid.Row="2" Grid.Column="1" Content="{Binding PlcRead.已生产数量}" />
                <Label Classes="Label" Grid.Row="3" Grid.Column="0" Content="工站名:" />
                <LinearPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                   <TextBox Text="{Binding StationNameInput, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch" />
                   <Button Content="确认" Command="{Binding ConfirmStationNameChangeCommand}" MinHeight="30" Padding="10 0" />
                </LinearPanel>
                <Label Classes="Label" Grid.Row="4" Grid.Column="0" Content="{StaticResource I18N.Common.CT_}" />
                <Label Classes="Value" Grid.Row="4" Grid.Column="1" Content="{Binding CTSecondsDisplay}" />
                <Label Classes="Label" Grid.Row="5" Grid.Column="0" Content="{StaticResource I18N.Common.工号_}" />
                <LinearPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                   <TextBox Text="{Binding WorkNoInput, Mode=TwoWay}" MinHeight="30" HorizontalAlignment="Stretch" />
                   <Button Content="确认" Command="{Binding ConfirmWorkNoChangeCommand}" MinHeight="30" Padding="10 0" />
                </LinearPanel>
             </Grid>
          </ViewContainer>

       </LayoutDockPanel.LeftTopContent>
       <LayoutDockPanel.LeftBottomContent>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <LinearPanel Orientation="Vertical">
             <LinearPanel.Styles>
                <Style Selector="ViewContainer">
                   <Setter Property="Padding" Value="4" />
                   <Setter Property="VerticalAlignment" Value="Stretch" />
                   <Setter Property="Background" Value="#423e3e" />
                </Style>
                <Style Selector="TextBlock">
                   <Setter Property="HorizontalAlignment" Value="Right" />
                   <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style Selector="Label">
                   <Setter Property="HorizontalAlignment" Value="Stretch" />
                   <Setter Property="VerticalAlignment" Value="Stretch"/>
                   <Setter Property="MinHeight" Value="26"/>
                   <Setter Property="Padding" Value="5 2"/>
                </Style>
                
             </LinearPanel.Styles>
             <ViewContainer Header="Feeder1">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder1MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder1Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder1抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder1IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder1" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder1IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder1" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>


             <ViewContainer Header="Feeder2">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder2MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder2Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder2抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder2IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder2" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder2IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder2" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>

             <ViewContainer Header="Feeder3">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder3MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder3Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder3抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder3IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder3" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder3IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder3" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>

             <ViewContainer Header="Feeder4">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="5" Margin="3">
                   <TextBlock Grid.Row="0" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.料号_}" />
                   <Label Grid.Row="0" Grid.Column="1" Classes="Value" Content="{Binding Feeder4MaterialCode}" />
                   <TextBlock Grid.Row="1" Grid.Column="0" Classes="Label" Text="飞达码:" />
                   <Label Grid.Row="1" Grid.Column="1" Classes="Value" Content="{Binding Feeder4Code}" />
                   <TextBlock Grid.Row="2" Grid.Column="0" Classes="Label" Text="{StaticResource I18N.Common.抛料率_}" />
                   <Label Grid.Row="2" Grid.Column="1" Classes="Value"
                            Content="{Binding PlcRead.Feeder4抛料率,StringFormat='{}{0:F2}%'}" />
                   <LinearPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                                     HorizontalAlignment="Center">
                      <Button Content="{StaticResource I18N.Common.解锁}" Classes="Primary" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2"
                                  IsEnabled="{Binding Feeder4IsUsed}"
                                  Command="{Binding FeederUnlockCommand}" CommandParameter="Feeder4" />
                      <Button Content="{StaticResource I18N.Common.换料}" Classes="Success" Theme="{DynamicResource Button-Solid}"
                                  Padding="10 2 "
                                  IsEnabled="{Binding Feeder4IsUsed}"
                                  Command="{Binding StartReplaceMonoCommand}" CommandParameter="Feeder4" />
                   </LinearPanel>
                </Grid>
             </ViewContainer>

          </LinearPanel>
          </ScrollViewer>
       </LayoutDockPanel.LeftBottomContent>

       <LayoutDockPanel.BottomLeftContent>
          <TabControl TabStripPlacement="Bottom">
             <TabItem Header="{StaticResource I18N.Common.日志栏}">
                <DataGrid Name="LogsDataGrid" ItemsSource="{Binding Logs}" GridLinesVisibility="All"
                               BorderBrush="{DynamicResource Brush-Border}" BorderThickness="1"
                               CanUserResizeColumns="True" FrozenColumnCount="3">
                   <DataGrid.Columns>
                      <DataGridTextColumn Header="记录器" Binding="{Binding LoggerName}" MinWidth="50" />
                      <DataGridTextColumn Header="时间" Binding="{Binding TimeStamp}" MinWidth="50" />
                      <DataGridTemplateColumn Header="等级">
                         <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                               <SelectableTextBlock
                                  Text="{Binding Level}" VerticalAlignment="Center" Padding="3 0"
                                  Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
                            </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="信息" Width="800">
                         <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                               <SelectableTextBlock
                                  Text="{Binding FormattedMessage}" VerticalAlignment="Center" Padding="3 0"
                                  Foreground="{Binding Level,  Converter={StaticResource LogLevelToConverter}}" />
                            </DataTemplate>
                         </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="异常" Binding="{Binding Exception}" Foreground="OrangeRed" MinWidth="50" />
                   </DataGrid.Columns>
                </DataGrid>
             </TabItem>
             </TabControl>
       </LayoutDockPanel.BottomLeftContent>

       <LayoutDockPanel.BottomRightContent>
          <LinearPanel Orientation="Vertical" Spacing="10">
             <ViewContainer Header="{StaticResource I18N.Common.设备状态}">
                <StackPanel Orientation="Vertical" Background="#252526" Margin="10">
             
                   <LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding PlcService.IsConnected}" />
                      </Grid>
                
                      <TextBlock Text="PLC" VerticalAlignment="Center" Foreground="White" />
                
                      <TextBlock Text="{Binding PlcService.Status}" VerticalAlignment="Center" Foreground="#AAAAAA" />
                   </LinearPanel>

                   <LinearPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScanner1Connected}" />
                      </Grid>
                      <TextBlock Text="Scanner1" Foreground="White" VerticalAlignment="Center"/>
                   </LinearPanel>
             
                   <LinearPanel Orientation="Horizontal" Spacing="8">
                      <Grid Width="12" Height="12" VerticalAlignment="Center">
                         <Ellipse Fill="Red" />
                         <Ellipse Fill="LimeGreen" IsVisible="{Binding IsScanner2Connected}" />
                      </Grid>
                      <TextBlock Text="Scanner2" Foreground="White" VerticalAlignment="Center"/>
                   </LinearPanel>
             
                </StackPanel>
             </ViewContainer>

             <LinearPanel Orientation="Horizontal" Spacing="10" Margin="2 4">
                <Label Content="联系方式:" FontWeight="Bold" />
                <TextBlock Text="{Binding AppConfig.联系方式}"></TextBlock>
             </LinearPanel>
          </LinearPanel>
       </LayoutDockPanel.BottomRightContent>
    </LayoutDockPanel>
</UiView>
