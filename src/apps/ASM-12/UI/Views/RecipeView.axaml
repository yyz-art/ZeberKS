<UiView xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:recipe="clr-namespace:ZitApp.UI.Recipe"
				xmlns:ext="using:ZC.UI.ControlLibs"
				mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
				x:Class="ZitApp.UI.Recipe.RecipeView"
				ShowContentMode="ForegroundContent">
	<Design.DataContext>
		<recipe:RecipeVM />
	</Design.DataContext>
	<UiView.DialogsContent>
		<TabControl>
			<TabItem Header="CreateNewRecipe">
				<RelativePanel>
					<DefaultDialog RelativePanel.AlignHorizontalCenterWithPanel="True" Name="CreateNewRecipeDialog"
												Title="{StaticResource I18N.Common.新建配方}" MinWidth="300" MinHeight="200">
						<Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="5" RowSpacing="10"
									VerticalAlignment="Center">
							<Label Grid.Row="0" Grid.Column="0" Content="{StaticResource I18N.Common.配方名称_}" VerticalAlignment="Center" />
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CreateNewRecipeInputName}" />
							<Label Grid.Row="1" Grid.Column="0" Content="{StaticResource I18N.Common.配方Id_}" VerticalAlignment="Center" />
							<ext:NumericIntUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CreateNewRecipeInputId}" />
							<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
													HorizontalAlignment="Center">
								<CheckBox Content="{StaticResource I18N.Common.复制当前配方值}"
													IsChecked="{Binding CreateNewRecipeIsCopyCurrentRecipeValue}">
								</CheckBox>
							</StackPanel>

							<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 20 0 0" Orientation="Horizontal"
													HorizontalAlignment="Center" Spacing="20">
								<Button Content="{DynamicResource I18N.Common.取消}"
												Theme="{DynamicResource Button-Outline}" Classes="Secondary"
												Command="{Binding CreateNewRecipeCancelCommand}" />
								<Button Content="{DynamicResource I18N.Common.确定}"
												Theme="{DynamicResource Button-Solid}"
												Command="{Binding CreateNewRecipeConfirmCommand}" />
							</StackPanel>
						</Grid>
					</DefaultDialog>
				</RelativePanel>
			</TabItem>
		</TabControl>
	</UiView.DialogsContent>
	<Grid RowDefinitions="Auto,*,Auto">
		<Border Grid.Row="0" BorderBrush="{DynamicResource Brush-Border}" BorderThickness="0 0 0 1">
			<LinearPanel Orientation="Horizontal" Margin="10 4" Spacing="10">
				<TextBlock Text="{StaticResource I18N.Common.配方_}" VerticalAlignment="Center" />
				<ComboBox ItemsSource="{Binding RecipeNames}" MinWidth="200"
									SelectedItem="{Binding SelectedRecipeName}" />
				<TextBlock Margin="10 0 0 0" Text="{StaticResource I18N.Common.配方Id_}" VerticalAlignment="Center" />
				<TextBox Text="{Binding EditRecipe.Id}" MinWidth="100" IsReadOnly="True" />
				<Control LinearPanel.Weight="1" />
				<Button Content="{StaticResource I18N.Common.删除}" Classes="Danger"
								Theme="{DynamicResource Button-Outline}"
								Command="{Binding DeleteSelectedRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.请求设备准备配方}" Classes="Primary"
								Theme="{DynamicResource Button-Solid}"
								Command="{Binding RequestDevicePrepareRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.下发}" Classes="Warning"
								Theme="{DynamicResource Button-Solid}"
								Command="{Binding DistributeSelectedRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.重新加载}" Classes="Warning"
								Theme="{DynamicResource Button-Outline}"
								Command="{Binding ReloadSelectedRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.新建}" Classes="Success"
								Theme="{DynamicResource Button-Outline}"
								Command="{Binding CreateNewRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.导出}" Classes="Success"
								Command="{Binding ExportSelectedRecipeCommand}" />
				<Button Content="{StaticResource I18N.Common.保存}"
								Theme="{DynamicResource Button-Solid}"
								Command="{Binding SaveSelectedRecipeCommand}" />

			</LinearPanel>
		</Border>
		<TabControl Grid.Row="1" TabStripPlacement="Left" Theme="{DynamicResource TabControl-Line}">
			<TabItem Header="{StaticResource I18N.Common.点位参数}" MinWidth="100">
				<Grid RowDefinitions="Auto,*" Margin="20" RowSpacing="10">
					<LinearPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
						<TextBlock Text="{StaticResource I18N.Common.列表筛选_}" VerticalAlignment="Center" />
						<ComboBox ItemsSource="{Binding PropertyCategories}" SelectedItem="{Binding SelectedPropertyCategory}"
											MinWidth="200" />
						<Control LinearPanel.Weight="1" />
						<CheckBox Content="{StaticResource I18N.Common.全选}" IsChecked="{Binding IsSelectedAll}"
											VerticalAlignment="Center" />
						<Button Content="{StaticResource I18N.Common.移动选中到保存值}"
										Command="{Binding MoveSelectedPointsCommand}" />
						<Button Content="{StaticResource I18N.Common.写入选中}"
										Command="{Binding WriteSelectedPointsCommand}" Classes="Warning" />
						<Button Content="{StaticResource I18N.Common.读取选中}"
										Command="{Binding ReadSelectedPointsCommand}" Classes="Success" />
					</LinearPanel>
					<DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPropertyInstances}"
										CanUserResizeColumns="True" GridLinesVisibility="All" BorderBrush="{DynamicResource Brush-Border}"
										BorderThickness="1">
						<DataGrid.Columns>
							<DataGridCheckBoxColumn Binding="{Binding Flag}">
							</DataGridCheckBoxColumn>
							<DataGridTextColumn Header="{StaticResource I18N.Common.类别}" Binding="{Binding ValueInfo.Category}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.数据名称}" Binding="{Binding Define.Name}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.类型}" Binding="{Binding Define.PropertyType.Name}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.保存值}" Binding="{Binding Value, Mode=TwoWay}"
																	IsReadOnly="False" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.读取值}" Binding="{Binding TempValue1,Mode=TwoWay }" />
							<DataGridTemplateColumn Header="{StaticResource I18N.Common.操作}">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" Spacing="5" Margin="2 2">

											<Button Content="{StaticResource I18N.Common.写入}" Classes="Warning"
															Command="{Binding DataContext.WritePointCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
															CommandParameter="{Binding .}" />

											<Button Content="{StaticResource I18N.Common.读取}" Classes="Success"
															Command="{Binding DataContext.ReadPointCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
															CommandParameter="{Binding .}" />
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="{StaticResource I18N.Common.上限值}" Binding="{Binding ValueInfo.MaxValue }" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.下限值}" Binding="{Binding ValueInfo.MinValue }" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.数据源}" Binding="{Binding ValueInfo.Source}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.单位}" Binding="{Binding ValueInfo.Unit}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.说明}" Binding="{Binding ValueInfo.Description}" />
							<DataGridTextColumn Header="{StaticResource I18N.Common.备注}" Binding="{Binding ValueInfo.Comment}"
																	IsReadOnly="False" />
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

			</TabItem>
			<TabItem IsSelected="True" Header="{StaticResource I18N.Common.产品上料}">
				<DataGrid ItemsSource="{Binding EditRecipe.产品上料信息}"
									GridLinesVisibility="All">
					<DataGrid.Columns>
						<DataGridTextColumn Header="上料位置名称" Binding="{Binding 上料位置名}" />
						<DataGridTextColumn Header="上料位置码" Binding="{Binding 上料位置识别码}" />
						<DataGridTextColumn Header="上料码1" Binding="{Binding 上料码1}" />
						<DataGridTextColumn Header="上料码2" Binding="{Binding 上料码2}" />
						<DataGridTextColumn Header="上料码3" Binding="{Binding 上料码3}" />
						<DataGridTextColumn Header="上料码4" Binding="{Binding 上料码4}" />
						<DataGridTextColumn Header="上料码5" Binding="{Binding 上料码5}" />
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>
			<TabItem Header="{StaticResource I18N.Common.视觉}">

			</TabItem>
		</TabControl>
	</Grid>
</UiView>