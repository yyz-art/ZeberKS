<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(DotnetTargetFrameworkVersion)</TargetFramework>
		<LangVersion>$(DotnetLangVersion)</LangVersion>		<RootNamespace>$(FrameworkName)App</RootNamespace>
		<AssemblyName>$(FrameworkName)App</AssemblyName>
		<OutputType>Exe</OutputType>
		<DefineConstants>DEFINE_MODEL_INCLUDE</DefineConstants>
		<Nullable>enable</Nullable>
		<ImplicitUsings>true</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>Assets/app.manifest</ApplicationManifest>
		<NoWarn>CA1822</NoWarn>
		
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Assets/.generated</CompilerGeneratedFilesOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>


		<!--发布打包-->
		<PublishSingleFile>false</PublishSingleFile>
		<SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
		<UsingSlnTasks>true</UsingSlnTasks>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<Optimize>false</Optimize>
	</PropertyGroup>

	<!--文件结构 -->
	<ItemGroup>
		<None Include="bin/Debug/**/*.*" Link="Assets/.bin-debug/%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="bin/Release/**/*.*" Link="Assets/.bin-release/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Remove="dist/**"/>
		<EmbeddedResource Remove="UI/dist/**"/>
		<None Remove="DDD.UbiquitousLanguageRegistry.txt"/>
		<AvaloniaResource Include="UI/Assets/**/*.*"/>
		<Folder Include="Assets\.bin-release\" />
		<Folder Include="Assets\@data\Images\" />
		<Folder Include="Services/Models/"/>
		<None Include="Assets/.generated/**/*"/>
		<None Remove="UI/dist/**"/>
		<None Remove="App.csproj.DotSettings"/>
		<None Update="UI/App.vue;UI/index.html;UI/package.json;UI/package-lock.json;UI/tsconfig.json;UI/vite.config.js" DependentUpon="app.js"/>
