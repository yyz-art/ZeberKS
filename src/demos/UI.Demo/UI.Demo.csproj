	<!-- Framework Using By Project	-->
	<ItemGroup Condition="'$(FrameworkUsingMode)'=='project'">
		<ProjectReference Include="$(FrameworkProjectPath)RoslynGen/RoslynGen.csproj" OutputItemType="Analyzer"/>
		<ProjectReference Include="$(FrameworkProjectPath)Application/Application.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)Base/Base.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)Tasks/Tasks.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)IOC/IOC.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)Mvvm/Mvvm.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)DB/DB.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)CFG/CFG.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)RES/RES.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)UI/UI.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)UI.Theme/UI.Theme.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)Web.Server/Web.Server.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)BinStructs/BinStructs.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)Enhance/Enhance.csproj"/>
	</ItemGroup>

	<ItemGroup Condition="'$(FrameworkUsingMode)'=='single-project'">
		<ProjectReference Include="$(FrameworkProjectPath)RoslynGen/RoslynGen.csproj" OutputItemType="Analyzer"/>
		<ProjectReference Include="$(FrameworkProjectPath)Framework/Framework.csproj"/>
		<ProjectReference Include="$(FrameworkProjectPath)UI.Theme/UI.Theme.csproj"/>
	</ItemGroup>
	<ItemGroup Condition="'$(FrameworkUsingMode)'=='single-assembly'">
		<Analyzer Include="$(FrameworkAssemblyPath)$(FrameworkName).RoslynGen.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Framework.dll"/>
		<ProjectReference Include="$(FrameworkProjectPath)UI.Theme/UI.Theme.csproj"/>
<!--		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).UI.Theme.dll"/>-->
	</ItemGroup>
	<!-- Framework Using By Assembly	-->
	<ItemGroup Condition="'$(FrameworkUsingMode)'=='assembly'">
		<Analyzer Include="$(FrameworkAssemblyPath)$(FrameworkName).RoslynGen.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Application.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Base.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Tasks.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).IOC.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Mvvm.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).DB.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).CFG.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).RES.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).UI.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).UI.Theme.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Web.Server.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).BinStructs.dll"/>
		<Reference Include="$(FrameworkAssemblyPath)$(FrameworkName).Enhance.dll"/>
	</ItemGroup>
	

	<Target Name="资源文件拷贝任务" AfterTargets="Build">
		<ItemGroup>
			<AssetsFiles
				Include="Assets/**/*.*"
				Exclude="Assets/@bin/**/*.*;Assets/@data/**/*.*;Assets/@Libs/**/*.*;
               Assets/**/*.cs;Assets/**/*.private.*;Assets/Styles/**/*.*;Assets/UI/**/*.*;" />
			<ToBinFiles Include="Assets/@bin/**/*.*" />
			<ToDataFiles Include="Assets/@data/**/*.*" />
			<ToLibsFiles Include="Assets/@Libs/**/*.*" />
			<WebFiles Include="UI/dist/**/*.*" />
		</ItemGroup>

		<FileCopyTask SourceFiles="@(AssetsFiles)" DestRoot="$(OutDir)assets" Mode="incremental" />
		<FileCopyTask SourceFiles="@(ToBinFiles)" DestRoot="$(OutDir)" Mode="incremental" />
		<FileCopyTask SourceFiles="@(ToDataFiles)" DestRoot="$(OutDir)data" Mode="incremental" />
		<FileCopyTask SourceFiles="@(ToLibsFiles)" DestRoot="$(OutDir)libs" Mode="incremental" />
		<FileCopyTask SourceFiles="@(WebFiles)" DestRoot="$(OutDir)assets/www" Mode="incremental" />
	</Target>




	<!--	文件清理任务-->
	<Target Name="文件清理任务" AfterTargets="Clean">
		<RemoveDir Directories="dist"/>
		<!--		<RemoveDir Directories="$(OutDir)"/>-->
		<Message Text="已删除 Web 'dist' 目录。" Importance="High"/>
	</Target>
	<Target Name="MoveDllsToLibsDir" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<ItemGroup>
			<DllsToMove Include="$(OutDir)*.dll;$(OutDir)*.pdb"
							Exclude="
							$(OutDir)$(AssemblyName).dll;
							$(OutDir)$(AssemblyName).pdb;
							$(OutDir)$(ProjectApplicationBaseName).*.*;"/>
		</ItemGroup>
		<RemoveDir Directories="$(OutDir)libs"/>
		<Copy SourceFiles="@(DllsToMove)"
				DestinationFolder="$(OutDir)libs/"
				SkipUnchangedFiles="true"
				OverwriteReadOnlyFiles="true"/>
		<Delete Files="@(DllsToMove)"/>
	</Target>
	<Target Name="BeforeBuild" BeforeTargets="Build">
		<RemoveDir Directories="obj\$(Configuration)" />
	</Target>
</Project>
