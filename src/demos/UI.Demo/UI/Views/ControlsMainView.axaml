<UserControl
	x:Class="OinetApp.UI.Views.ControlsMainView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views1="clr-namespace:OinetApp.UI.Views"
	xmlns:pages="clr-namespace:OinetApp.UI.Controls"
	xmlns:demo="clr-namespace:OinetApp.UI.Views.Demo"
	d:DesignHeight="720"
	d:DesignWidth="1280"
	x:CompileBindings="True"
	x:DataType="ControlsMainViewModel"
	mc:Ignorable="d">
	<UserControl.Resources>
		<ControlTheme x:Key="CategoryTabItem" TargetType="TabItem">
			<Setter Property="IsEnabled" Value="False" />
			<Setter Property="Template">
				<ControlTemplate TargetType="TabItem">
					<TextBlock
						FontWeight="Bold"
						FontSize="12"
						Margin="4"
						Text="{TemplateBinding Header}" />
				</ControlTemplate>
			</Setter>
			<Style Selector="^:disabled /template/ TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource Brush-Text1}" />
			</Style>
		</ControlTheme>
	</UserControl.Resources>
	<Grid RowDefinitions="Auto, *">
		<Border
			Grid.Row="0"
			Margin="8"
			Padding="12,4"
			Theme="{DynamicResource Border-Card}">
			<Panel>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<ToggleSwitch
						Name="ExpandButton"
						Theme="{DynamicResource IconBorderlessToggleSwitch}"
						Content="{StaticResource Icon-Sidebar}" />
					<SelectableTextBlock
						VerticalAlignment="Center"
						Classes="H6"
						Text="Oinet.UI"
						Theme="{DynamicResource SelectableTextBlock-Title}" />
					<SelectableTextBlock
						VerticalAlignment="Center"
						Text="/" />
					<SelectableTextBlock
						VerticalAlignment="Center"
						Classes="Secondary"
						Text="{ReflectionBinding #tab.SelectedItem.Header}" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button
						Theme="{DynamicResource IconBorderlessButton}"
						Command="{Binding OpenUrlCommand}"
						CommandParameter="{Binding DocumentationUrl}"
						Content="{StaticResource Icon-Globe}" />

					<Button
						Theme="{DynamicResource IconBorderlessButton}"
						Command="{Binding OpenUrlCommand}"
						CommandParameter="{Binding RepoUrl}"
						Content="{StaticResource Icon-GithubLogo}" />

					<ToggleSwitch
						Theme="{DynamicResource IconBorderlessToggleSwitch}"
						Command="{Binding ToggleThemeCommand}"
						OnContent="{StaticResource Icon-Moon}"
						OffContent="{StaticResource Icon-Sun}" />

					<Button
						Theme="{DynamicResource IconBorderlessButton}"
						Content="{StaticResource Icon-Menu}">
						<Button.Flyout>
							<MenuFlyout Placement="Bottom" ItemsSource="{Binding MenuItems}" />
						</Button.Flyout>
						<Button.Styles>
							<Style Selector="MenuItem" x:DataType="MenuItemViewModel">
								<Setter Property="Header" Value="{Binding Header}" />
								<Setter Property="ItemsSource" Value="{Binding Items}" />
								<Setter Property="Command" Value="{Binding Command}" />
								<Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
							</Style>
						</Button.Styles>
					</Button>
				</StackPanel>
			</Panel>
		</Border>
		<TabControl
			Name="tab"
			Grid.Row="1"
			Margin="8"
			Padding="20,0,0,0"
			TabStripPlacement="Left"
			Classes.Dismiss="{Binding #ExpandButton.IsChecked}"
			Theme="{DynamicResource TabControl-ScrollLine}">
			<TabControl.Styles>
				<Style Selector=".Dismiss /template/ ScrollViewer#PART_ScrollViewer">
					<Setter Property="IsVisible" Value="False" />
				</Style>
			</TabControl.Styles>
			<TabControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel />
				</ItemsPanelTemplate>
			</TabControl.ItemsPanel>
			<TabItem Header="Overview">
				<demo:Overview />
			</TabItem>
			<TabItem Header="About Us">
				<AboutUs />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Resource Browser" />
			<TabItem Header="Palette">
				<demo:PaletteDemo />
			</TabItem>
			<TabItem Header="HighContrastTheme">
				<demo:HighContrastDemo />
			</TabItem>
			<TabItem Header="Variables">
				<demo:VariablesDemo />
			</TabItem>
			<TabItem Header="Icon">
				<demo:IconDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Separate Pack" />
			<TabItem Header="ColorPicker">
				<demo:ColorPickerDemo />
			</TabItem>
			<TabItem Header="DataGrid">
				<demo:DataGridDemo />
			</TabItem>
			<TabItem Header="TreeDataGrid">
				<demo:TreeDataGridDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Basic" />
			<TabItem Header="TextBlock">
				<demo:TextBlockDemo />
			</TabItem>
			<TabItem Header="SelectableTextBlock">
				<demo:SelectableTextBlockDemo />
			</TabItem>
			<TabItem Header="Border">
				<demo:BorderDemo />
			</TabItem>
			<TabItem Header="PathIcon">
				<demo:PathIconDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Button" />
			<TabItem Header="Button">
				<demo:ButtonDemo />
			</TabItem>
			<TabItem Header="RepeatButton">
				<demo:RepeatButtonDemo />
			</TabItem>
			<TabItem Header="HyperlinkButton">
				<demo:HyperlinkButtonDemo />
			</TabItem>
			<TabItem Header="ToggleButton">
				<demo:ToggleButtonDemo />
			</TabItem>
			<TabItem Header="CheckBox">
				<demo:CheckBoxDemo />
			</TabItem>
			<TabItem Header="RadioButton">
				<demo:RadioButtonDemo />
			</TabItem>
			<TabItem Header="ToggleSwitch">
				<demo:ToggleSwitchDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Input" />
			<TabItem Header="TextBox">
				<demo:TextBoxDemo />
			</TabItem>
			<TabItem Header="AutoCompleteBox">
				<demo:AutoCompleteBoxDemo />
			</TabItem>
			<TabItem Header="ComboBox">
				<demo:ComboBoxDemo />
			</TabItem>
			<TabItem Header="ButtonSpinner">
				<demo:ButtonSpinnerDemo />
			</TabItem>
			<TabItem Header="NumericUpDown">
				<demo:NumericUpDownDemo />
			</TabItem>
			<TabItem Header="Slider">
				<demo:SliderDemo />
			</TabItem>
			<TabItem Header="ManagedFileChooser">
				<demo:ManagedFileChooserDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Date/Time" />
			<TabItem Header="Calendar">
				<demo:CalendarDemo />
			</TabItem>
			<TabItem Header="CalendarDatePicker">
				<demo:CalendarDatePickerDemo />
			</TabItem>
			<TabItem Header="DatePicker">
				<demo:DatePickerDemo />
			</TabItem>
			<TabItem Header="TimePicker">
				<demo:TimePickerDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Navigation" />
			<TabItem Header="TabControl">
				<demo:TabControlDemo />
			</TabItem>
			<TabItem Header="TabStrip">
				<demo:TabStripDemo />
			</TabItem>
			<TabItem Header="TreeView">
				<!-- <pages:TreeViewDemo /> -->
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Show" />
			<TabItem Header="Carousel">
				<demo:CarouselDemo />
			</TabItem>
			<TabItem Header="Expander">
				<demo:ExpanderDemo />
			</TabItem>
			<TabItem Header="Flyout">
				<demo:FlyoutDemo />
			</TabItem>
			<TabItem Header="HeaderedContentControl">
				<demo:HeaderedContentControlDemo />
			</TabItem>
			<TabItem Header="Label">
				<demo:LabelDemo />
			</TabItem>
			<TabItem Header="ListBox">
				<demo:ListBoxDemo />
			</TabItem>
			<TabItem Header="SplitView">
				<demo:SplitViewDemo />
			</TabItem>
			<TabItem Header="ToolTip">
				<demo:ToolTipDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Feedback" />
			<TabItem Header="DataValidationErrors">
				<demo:DataValidationErrorsDemo />
			</TabItem>
			<TabItem Header="Notification">
				<demo:NotificationDemo />
			</TabItem>
			<TabItem Header="ProgressBar">
				<demo:ProgressBarDemo />
			</TabItem>
			<TabItem Header="RefreshContainer">
				<demo:RefreshContainerDemo />
			</TabItem>
			<TabItem
				Theme="{DynamicResource CategoryTabItem}"
				Header="Other" />
			<TabItem Header="GridSplitter">
				<demo:GridSplitterDemo />
			</TabItem>
			<TabItem Header="Menu">
				<demo:MenuDemo />
			</TabItem>
			<TabItem Header="ScrollViewer">
				<demo:ScrollViewerDemo />
			</TabItem>
			<TabItem Header="ThemeVariantScope">
				<demo:ThemeVariantDemo />
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>