<UserControl
	x:Class="OinetApp.UI.Views.Demo.Overview"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="768"
	d:DesignWidth="1280"
	mc:Ignorable="d">
	<UserControl.Resources>
		<ResourceDictionary>
			<converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
		</ResourceDictionary>
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Border.CodeBlock">
			<Setter Property="BorderBrush" Value="{DynamicResource Color-Border}" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Background" Value="{DynamicResource Brush-Fill0}" />
		</Style>
	</UserControl.Styles>
	<ScrollViewer HorizontalScrollBarVisibility="Auto">
		<StackPanel Margin="20">
			<StackPanel
				Margin="20"
				HorizontalAlignment="Center"
				Orientation="Horizontal">

				<!-- <PathIcon -->
				<!-- 	Width="10" -->
				<!-- 	Height="10" -->
				<!-- 	Margin="20,0" -->
				<!-- 	Data="{StaticResource Icon-Plus}" /> -->
				<Image Width="32" Height="32">
					<Image.Source>
						<DrawingImage>
							<DrawingGroup>
								<GeometryDrawing Brush="#0D6EFD"
														Geometry="M74.8535 85.8231C75.0263 85.8231 75.1954 85.8231 75.3679 85.8231C80.7347 85.8231 85.1439 81.8027 85.7614 76.6019L85.8357 41.7604C85.2255 18.5931 66.2537 0 42.9393 0C19.2399 0 0.02771 19.2122 0.02771 42.9116C0.02771 66.3573 18.8309 85.418 42.18 85.8231H74.8535Z" />
								<GeometryDrawing Brush="White"
														Geometry="M43.0585 14.6143C29.5513 14.6143 18.2555 24.082 15.4454 36.7432C18.1357 37.4975 20.1087 39.9679 20.1087 42.8992C20.1087 45.8305 18.1357 48.301 15.4454 49.0552C18.2555 61.7164 29.5513 71.1842 43.0585 71.1842C47.9754 71.1842 52.5993 69.9296 56.6276 67.723V70.9926H71.3435V44.0716C71.3569 43.7138 71.3435 43.2603 71.3435 42.8992C71.3435 27.2779 58.6799 14.6143 43.0585 14.6143ZM29.5096 42.8992C29.5096 35.4164 35.5757 29.3503 43.0585 29.3503C50.5414 29.3503 56.6074 35.4164 56.6074 42.8992C56.6074 50.3821 50.5414 56.4481 43.0585 56.4481C35.5757 56.4481 29.5096 50.3821 29.5096 42.8992Z" />
								<GeometryDrawing Brush="White"
														Geometry="M18.105 42.8805C18.105 45.3803 16.0785 47.4068 13.5787 47.4068C11.0789 47.4068 9.05237 45.3803 9.05237 42.8805C9.05237 40.3807 11.0789 38.3542 13.5787 38.3542C16.0785 38.3542 18.105 40.3807 18.105 42.8805Z" />
							</DrawingGroup>
						</DrawingImage>
					</Image.Source>
				</Image>
				<TextBlock
					HorizontalAlignment="Center"
					Margin="20 0 0 0"
					Classes="H1"
					Text="Avalonia"
					Theme="{DynamicResource TextBlock-Title}" />
			</StackPanel>


			<StackPanel
				Margin="0,10,0,0"
				HorizontalAlignment="Center"
				Orientation="Horizontal">
				<TextBlock
					Margin="12,0"
					FontWeight="600"
					Text="Modern" />
				<TextBlock
					Margin="12,0"
					FontWeight="600"
					Foreground="{Binding #color.Color, Converter={StaticResource ColorToBrushConverter}, Mode=TwoWay}"
					Text="Flexible" />
				<TextBlock
					Margin="12,0"
					FontWeight="600"
					Text="Simple" />
			</StackPanel>
			<StackPanel HorizontalAlignment="Center">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<StackPanel Margin="16,0">
							<Button
								Margin="0,8"
								Classes="Primary"
								Content="Primary"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
							<Button
								Margin="0,8"
								Classes="Secondary"
								Content="Secondary"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
							<Button
								Margin="0,8"
								Classes="Tertiary"
								Content="Tertiary"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
							<Button
								Margin="0,8"
								Classes="Success"
								Content="Success"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
							<Button
								Margin="0,8"
								Classes="Warning"
								Content="Warning"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
							<Button
								Margin="0,8"
								Classes="Danger"
								Content="Danger"
								HorizontalAlignment="Stretch"
								Theme="{DynamicResource Button-Solid}" />
						</StackPanel>
						<Calendar Margin="16,0" />
						<StackPanel Margin="16,0">
							<TextBox
								Width="300"
								Margin="0,12"
								InnerLeftContent="https://"
								InnerRightContent=".com" />
							<DatePicker Width="300" Margin="0,12" />
							<CalendarDatePicker Width="300" Margin="0,12" />
							<NumericUpDown Width="300" Margin="0,12" />
							<ComboBox Width="300" Margin="0,12">
								<ComboBoxItem>Avalonia</ComboBoxItem>
								<ComboBoxItem>Semi Design</ComboBoxItem>
								<ComboBoxItem>IRIHI Technology</ComboBoxItem>
							</ComboBox>
						</StackPanel>
						<StackPanel>
							<UniformGrid HorizontalAlignment="Center" Columns="3">
								<UniformGrid.Styles>
									<Style Selector="CheckBox">
										<Setter Property="Margin" Value="4" />
									</Style>
								</UniformGrid.Styles>
								<CheckBox Content="Windows" IsChecked="True" />
								<CheckBox Content="macOS" IsChecked="True" />
								<CheckBox Content="Linux" IsChecked="True" />
								<CheckBox
									Content="iOS"
									IsChecked="{x:Null}"
									IsThreeState="True" />
								<CheckBox
									Content="Android"
									IsChecked="{x:Null}"
									IsThreeState="True" />
								<CheckBox
									Content="Wasm"
									IsChecked="{x:Null}"
									IsThreeState="True" />
							</UniformGrid>
							<UniformGrid HorizontalAlignment="Center" Columns="3">
								<UniformGrid.Styles>
									<Style Selector="CheckBox">
										<Setter Property="Margin" Value="4" />
									</Style>
								</UniformGrid.Styles>
								<CheckBox
									Content="Windows"
									IsChecked="True"
									Theme="{DynamicResource CheckBox-Card}" />
								<CheckBox
									Content="macOS"
									IsChecked="True"
									Theme="{DynamicResource CheckBox-Card}" />
								<CheckBox
									Content="Linux"
									IsChecked="True"
									Theme="{DynamicResource CheckBox-Card}" />
								<CheckBox
									Content="iOS"
									IsChecked="{x:Null}"
									IsThreeState="True"
									Theme="{DynamicResource CheckBox-Card}" />
								<CheckBox
									Content="Android"
									IsChecked="{x:Null}"
									IsThreeState="True"
									Theme="{DynamicResource CheckBox-Card}" />
								<CheckBox
									Content="Wasm"
									IsChecked="{x:Null}"
									IsThreeState="True"
									Theme="{DynamicResource CheckBox-Card}" />
							</UniformGrid>
						</StackPanel>

					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<StackPanel Margin="16,0">
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Primary"
								Content="Primary" />
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Secondary"
								Content="Secondary" />
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Tertiary"
								Content="Tertiary" />
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Success"
								Content="Success" />
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Warning"
								Content="Warning" />
							<Button
								Margin="0,8"
								HorizontalAlignment="Stretch"
								Classes="Danger"
								Content="Danger" />
						</StackPanel>
						<ColorView
							Name="color"
							VerticalAlignment="Top"
							Palette="{DynamicResource Color-Palette}"
							SelectedIndex="2"
							Color="#0D6EFD" />
						<StackPanel Width="300" Margin="8">
							<StackPanel Orientation="Horizontal">
								<Slider
									Name="slider"
									Width="200"
									Margin="16"
									Maximum="100"
									Minimum="0" />
								<ToggleSwitch Name="three" IsChecked="True" />
							</StackPanel>
							<UniformGrid Columns="2">
								<ProgressBar
									Width="100"
									MinWidth="100"
									Margin="0,16"
									IsIndeterminate="{Binding #three.IsChecked}"
									ShowProgressText="True"
									Value="{Binding #slider.Value}" />
								<ProgressBar
									Width="100"
									Height="100"
									IsIndeterminate="{Binding #three.IsChecked}"
									ShowProgressText="True"
									Theme="{DynamicResource ProgressBar-Ring}"
									Value="{Binding #slider.Value}" />
							</UniformGrid>
							<TabStrip Margin="0,8">
								<TabStripItem Content="Tab 1" />
								<TabStripItem Content="Tab 2" />
								<TabStripItem Content="Tab 3" />
							</TabStrip>
							<Menu Margin="0,8">
								<MenuItem Header="Menu 1">
									<MenuItem Header="SubMenu 1" />
									<MenuItem Header="SubMenu 2" />
									<MenuItem Header="SubMenu 3" />
								</MenuItem>
								<MenuItem Header="Menu 2">
									<MenuItem Header="SubMenu 1" />
									<MenuItem Header="SubMenu 2" />
									<MenuItem Header="SubMenu 3" />
									<MenuItem Header="SubMenu 4">
										<MenuItem Header="SubMenu 1" />
										<MenuItem Header="SubMenu 2" />
										<MenuItem Header="SubMenu 3" />
									</MenuItem>
								</MenuItem>
								<MenuItem Header="Menu 3" />
							</Menu>

						</StackPanel>
						<StackPanel Margin="8">

							<UniformGrid HorizontalAlignment="Center" Columns="3">
								<UniformGrid.Styles>
									<Style Selector="RadioButton">
										<Setter Property="Margin" Value="4" />
										<Setter Property="HorizontalAlignment" Value="Center" />
									</Style>
								</UniformGrid.Styles>
								<RadioButton Content="Avalonia" IsChecked="True" />
								<RadioButton Content="WPF" />
								<RadioButton Content="Xamarin" />
							</UniformGrid>
							<UniformGrid HorizontalAlignment="Center" Columns="3">
								<UniformGrid.Styles>
									<Style Selector="RadioButton">
										<Setter Property="Margin" Value="4" />
										<Setter Property="HorizontalAlignment" Value="Center" />
									</Style>
								</UniformGrid.Styles>
								<RadioButton
									Content="Avalonia"
									IsChecked="True"
									Theme="{DynamicResource RadioButton-Card}" />
								<RadioButton Content="WPF" Theme="{DynamicResource RadioButton-Card}" />
								<RadioButton Content="Xamarin" Theme="{DynamicResource RadioButton-Card}" />
							</UniformGrid>
							<WrapPanel Width="300">
								<WrapPanel.Styles>
									<Style Selector="Label">
										<Setter Property="Margin" Value="4" />
										<Setter Property="HorizontalContentAlignment" Value="Center" />
									</Style>
								</WrapPanel.Styles>
								<Label Classes="Red" Theme="{StaticResource Label-Tag}">Red</Label>
								<Label Classes="Pink" Theme="{StaticResource Label-Tag}">Pink</Label>
								<Label Classes="Purple" Theme="{StaticResource Label-Tag}">Purple</Label>
								<Label Classes="Violet" Theme="{StaticResource Label-Tag}">Violet</Label>
								<Label Classes="Indigo" Theme="{StaticResource Label-Tag}">Indigo</Label>
								<Label Classes="Blue" Theme="{StaticResource Label-Tag}">Blue</Label>
								<Label Classes="LightBlue" Theme="{StaticResource Label-Tag}">LightBlue</Label>
								<Label Classes="Cyan" Theme="{StaticResource Label-Tag}">Cyan</Label>
								<Label Classes="Teal" Theme="{StaticResource Label-Tag}">Teal</Label>
								<Label Classes="Green" Theme="{StaticResource Label-Tag}">Green</Label>
								<Label Classes="LightGreen" Theme="{StaticResource Label-Tag}">LightGreen</Label>
								<Label Classes="Lime" Theme="{StaticResource Label-Tag}">Lime</Label>
								<Label Classes="Yellow" Theme="{StaticResource Label-Tag}">Yellow</Label>
								<Label Classes="Amber" Theme="{StaticResource Label-Tag}">Amber</Label>
								<Label Classes="Orange" Theme="{StaticResource Label-Tag}">Orange</Label>
								<Label Classes="Grey" Theme="{StaticResource Label-Tag}">Grey</Label>
								<Label Classes="White" Theme="{StaticResource Label-Tag}">White</Label>
								<Label Classes="Large" Theme="{StaticResource Label-Tag}">Large</Label>
								<Label Classes="Circle" Theme="{StaticResource Label-Tag}">Circle</Label>
							</WrapPanel>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>