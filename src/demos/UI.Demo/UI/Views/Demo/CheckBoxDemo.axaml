<UserControl
	x:Class="OinetApp.UI.Views.Demo.CheckBoxDemo"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<ScrollViewer HorizontalScrollBarVisibility="Auto">
		<StackPanel HorizontalAlignment="Left" Spacing="20">
			<TextBlock Text="CheckBox" />
			<StackPanel Orientation="Horizontal">
				<CheckBox>Unchecked</CheckBox>
				<CheckBox IsChecked="True">Checked</CheckBox>
				<CheckBox IsChecked="{x:Null}" IsThreeState="True">Indeterminate</CheckBox>
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<CheckBox IsEnabled="False">Unchecked</CheckBox>
				<CheckBox IsChecked="True" IsEnabled="False">Checked</CheckBox>
				<CheckBox
					IsChecked="{x:Null}"
					IsEnabled="False"
					IsThreeState="True">
					Indeterminate
				</CheckBox>
			</StackPanel>
			<CheckBox Width="120" HorizontalAlignment="Left">Checkbox should wrap its text</CheckBox>
			<TextBlock Text="CheckBox-Simple" />
			<StackPanel Orientation="Horizontal">
				<CheckBox Theme="{StaticResource CheckBox-Simple}" />
				<CheckBox IsChecked="True" Theme="{StaticResource CheckBox-Simple}" />
				<CheckBox
					IsChecked="{x:Null}"
					IsThreeState="True"
					Theme="{StaticResource CheckBox-Simple}" />
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<CheckBox IsEnabled="False" Theme="{StaticResource CheckBox-Simple}" />
				<CheckBox
					IsChecked="True"
					IsEnabled="False"
					Theme="{StaticResource CheckBox-Simple}" />
				<CheckBox
					IsChecked="{x:Null}"
					IsEnabled="False"
					IsThreeState="True"
					Theme="{StaticResource CheckBox-Simple}" />
			</StackPanel>
			<TextBlock Text="CheckBox-Card" />
			<StackPanel Orientation="Horizontal">
				<StackPanel.Styles>
					<Style Selector="CheckBox">
						<Setter Property="Width" Value="150" />
						<Setter Property="Margin" Value="8" />
					</Style>
				</StackPanel.Styles>
				<CheckBox
					Content="Windows"
					IsChecked="True"
					Theme="{DynamicResource CheckBox-Card}" />
				<CheckBox
					Content="macOS"
					IsChecked="True"
					IsEnabled="False"
					Theme="{DynamicResource CheckBox-Card}" />
				<CheckBox
					Content="Linux"
					IsChecked="True"
					Theme="{DynamicResource CheckBox-Card}" />
				<CheckBox
					Content="iOS"
					IsChecked="{x:Null}"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-Card}" />
				<CheckBox
					Content="Android"
					IsChecked="{x:Null}"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-Card}" />
				<CheckBox
					Content="Wasm"
					IsChecked="False"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-Card}" />
			</StackPanel>
			<TextBlock Text="CheckBox-PureCard" />
			<StackPanel Orientation="Horizontal">
				<StackPanel.Styles>
					<Style Selector="CheckBox">
						<Setter Property="Width" Value="150" />
						<Setter Property="Margin" Value="8" />
					</Style>
				</StackPanel.Styles>
				<CheckBox
					Content="Windows"
					IsChecked="True"
					Theme="{DynamicResource CheckBox-PureCard}" />
				<CheckBox
					Content="macOS"
					IsChecked="True"
					IsEnabled="False"
					Theme="{DynamicResource CheckBox-PureCard}" />
				<CheckBox
					Content="Linux"
					IsChecked="True"
					Theme="{DynamicResource CheckBox-PureCard}" />
				<CheckBox
					Content="iOS"
					IsChecked="{x:Null}"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-PureCard}" />
				<CheckBox
					Content="Android"
					IsChecked="{x:Null}"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-PureCard}" />
				<CheckBox
					Content="Wasm"
					IsChecked="False"
					IsThreeState="True"
					Theme="{DynamicResource CheckBox-PureCard}" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>