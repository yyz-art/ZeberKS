<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<StackPanel Orientation="Horizontal">
			<ToggleSwitch
				Theme="{DynamicResource IconBorderlessToggleSwitch}"
				Content="{StaticResource Icon-Star}" />
			<Button
				Theme="{DynamicResource IconBorderlessButton}"
				Content="{StaticResource Icon-Star}" />
		</StackPanel>
	</Design.PreviewWith>

	<ControlTheme x:Key="IconBorderlessToggleSwitch"
						BasedOn="{StaticResource ToggleSwitch-Button}"
						TargetType="ToggleSwitch">
		<Setter Property="Padding" Value="{StaticResource Thickness-Tight}" />
		<Setter Property="Width" Value="{StaticResource Spacing-ExtraLoose}" />
		<Setter Property="Height" Value="{StaticResource Spacing-ExtraLoose}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush-Text1}" />
		<Setter Property="OnContentTemplate">
			<StaticResource ResourceKey="GeometryDataTemplate" />
		</Setter>
		<Setter Property="OffContentTemplate">
			<StaticResource ResourceKey="GeometryDataTemplate" />
		</Setter>
		<Setter Property="ContentTemplate">
			<StaticResource ResourceKey="GeometryDataTemplate" />
		</Setter>
	</ControlTheme>

	<ControlTheme x:Key="IconBorderlessButton"
						BasedOn="{StaticResource Button-Borderless}"
						TargetType="Button">
		<Setter Property="Padding" Value="{StaticResource Thickness-Tight}" />
		<Setter Property="Width" Value="{StaticResource Spacing-ExtraLoose}" />
		<Setter Property="Height" Value="{StaticResource Spacing-ExtraLoose}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush-Text1}" />
		<Setter Property="ContentTemplate">
			<StaticResource ResourceKey="GeometryDataTemplate" />
		</Setter>
	</ControlTheme>

	<DataTemplate x:Key="GeometryDataTemplate" DataType="Geometry">
		<PathIcon Theme="{StaticResource PathIcon-Inner}" Data="{Binding}" />
	</DataTemplate>
</ResourceDictionary>