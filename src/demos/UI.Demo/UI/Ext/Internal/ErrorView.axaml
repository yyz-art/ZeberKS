<UiView xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:internal="clr-namespace:OinetApp.UI.Internal"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="OinetApp.UI.Internal.ErrorView">
	<Design.DataContext>
		<internal:ErrorVM />
	</Design.DataContext>
	<Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="10">
		<PathIcon
			Grid.Row="0" Grid.Column="0" Width="30"
			Foreground="{DynamicResource Brush-Red}" Height="30"
			Data="{DynamicResource Icon-AlertCircle}" />
		<TextBlock Grid.Row="0" Grid.Column="1" Text="应用程序错误" FontWeight="Bold"
		           FontSize="{StaticResource FontSize-B3 }"
		           VerticalAlignment="Center" />
		<Button Theme="{DynamicResource Button-Borderless}"
		        Command="{Binding CloseCommand}"
		        Foreground="{DynamicResource Brush-Text3}" Grid.Row="0"
		        Grid.Column="2">
			<PathIcon Data="{StaticResource Icon-Close}" />
		</Button>
		<Grid Grid.Row="1" Margin="0 10 0 0" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*"
		      RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="发送者" HorizontalAlignment="Right" FontWeight="Bold" />
			<SelectableTextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Sender}" />
			<TextBlock Grid.Row="1" Grid.Column="0" Text="错误源"  HorizontalAlignment="Right" FontWeight="Bold" />
			<SelectableTextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding From}" />
			<TextBlock Grid.Row="2" Grid.Column="0" Text="参数" TextWrapping="Wrap" HorizontalAlignment="Right" FontWeight="Bold" />
			<SelectableTextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Args}" />
			<TextBlock Grid.Row="3" Grid.Column="0" Text="错误" HorizontalAlignment="Right" FontWeight="Bold" />
			<SelectableTextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource Brush-Red}" Text="{Binding Error}" />
		</Grid>
	</Grid>
</UiView>